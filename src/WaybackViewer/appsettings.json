{
  "Logging": {
    "File": { "Directory": "E:\\WaybackViewer\\logs", "MinLevel": "Debug" },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "WaybackViewer.Services.ArchiveClient": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WaybackDb": "Data Source=E:\\WaybackViewer\\wayback.db"
  },
  "Storage": {
    "Provider": "Sqlite",
    "SearchMaxAgeDays": 30,
    "HtmlRoot": "E:\\WaybackViewer\\html-payloads",
    "TempDirectory": "E:\\WaybackViewer\\temp",
    "KeysDirectory": "E:\\WaybackViewer\\keys"
  },
  "Archive": {
    "MaxConcurrency": 8,
    "MinIntervalMs": 100,
    "MaxIntervalMs": 10000,
    "MaxAttempts": 5,
    "RequestTimeoutSeconds": 180
  },
  "Preload": {
    "Scope": "view",
    "Workers": 8,
    "MaxQueuedPerJob": 1000,
    "WriteBatchSize": 50,
    "WriteMaxDelayMs": 300,
    "MaxHtmlChars": 5000000
  }
}
