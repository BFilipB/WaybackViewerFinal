{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WaybackDb": "Data Source=wayback.db"
  },
  "Storage": {
    "Provider": "Sqlite",
    "SearchMaxAgeDays": 30
  },
  "Archive": {
    "MaxConcurrency": 8,
    "MinIntervalMs": 100,
    "MaxIntervalMs": 10000,
    "MaxAttempts": 5,
    "RequestTimeoutSeconds": 180
  },
  "Preload": {
    "Workers": 8,
    "WriteBatchSize": 50,
    "WriteMaxDelayMs": 300,
    "MaxHtmlChars": 5000000
  }
}
