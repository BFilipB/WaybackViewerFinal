			.card.selected { border-color: var(--accent); background: var(--panel2); }

			/* card view: every part has a fixed grid cell, long text wraps or truncates, buttons never overlap text */
			.capture-list:not(.compact) .meta { grid-template-columns: 140px minmax(0, 1fr) max-content; grid-template-areas: "date url actions" "date details actions" "date badges actions"; row-gap: 4px; align-items: start; }
			.capture-list:not(.compact) .capture-date { grid-area: date; }
			.capture-list:not(.compact) .url { grid-area: url; min-width: 0; }
