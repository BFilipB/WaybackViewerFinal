<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"]</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; padding: 16px; background: #111; color: #eee; }
    .bar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; align-items: center; }
    input, select { padding: 6px; background: #222; color: #eee; border: 1px solid #444; }
    button, .btn { padding: 6px 10px; background: #2a2a2a; color: #eee; border: 1px solid #555;
                   cursor: pointer; text-decoration: none; font-size: 13px; }
    button:hover, .btn:hover { background: #3a3a3a; }
    button.btn-busy, .btn.btn-busy { opacity: .85; cursor: progress; }
    .capture-list { display: flex; flex-direction: column; gap: 6px; max-width: 1100px; }
    .card { background: #1c1c1c; border: 1px solid #333; display: flex; }
    .card[hidden] { display: none; }
    .meta { width: 100%; padding: 8px 10px; display: grid; grid-template-columns: 150px minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; font-size: 12px; }
    .capture-date { color: #bbb; white-space: nowrap; }
    .url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .capture-details { color: #999; grid-column: 2; }
    .row { display: flex; gap: 6px; }
    .meta .row { grid-column: 3; grid-row: 1 / span 2; }
    .ss { position: fixed; inset: 0; background: #000; z-index: 100; display: flex; flex-direction: column; }
    .ss[hidden] { display: none; }
    .ssbar { display: flex; gap: 10px; align-items: center; padding: 8px 12px; background: #1a1a1a; flex-wrap: wrap; }
    .ssbar #ssInfo { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
    .jump { display: flex; gap: 5px; align-items: center; font-size: 12px; white-space: nowrap; }
    .jump input { width: 125px; padding: 5px; }
    .sshint { font-size: 12px; color: #999; }
    #expStatus { color: #9cc9ff; font-size: 12px; }
    .ssmain { flex: 1; display: flex; min-height: 0; padding: 14px 18px; gap: 14px; background: radial-gradient(circle at top, #1f2430, #0b0d12); }
    .ssframe { flex: 1; min-width: 0; border: 1px solid #3a4150; border-top: 26px solid #2b303b; border-radius: 10px; background: #fff;
               box-shadow: 0 12px 40px rgba(0,0,0,.6); }
    .ssframe[hidden] { display: none; }
    .card { border-radius: 8px; transition: border-color .15s, transform .15s; }
    .card:hover { border-color: #5b8bd0; transform: translateX(2px); }
    .ssbar { background: #151922; border-bottom: 1px solid #2a2f3a; }
    button, .btn { border-radius: 6px; }
    .capture-row { content-visibility: auto; contain-intrinsic-size: auto 58px; }
    .ssreader { flex: 1; min-width: 0; overflow: auto; padding: 24px 32px; background: #161a22; border: 1px solid #2a2f3a; border-radius: 10px; }
    .ssreader[hidden] { display: none; }
    .ssreader h2 { margin: 0 0 8px; font-size: 19px; }
    .ssdesc { color: #9cc9ff; margin: 0 0 14px; }
    .ssreader pre { white-space: pre-wrap; font: 14px/1.55 system-ui, sans-serif; margin: 0; max-width: 900px; }
    .empty-state { color: #aaa; max-width: 640px; line-height: 1.5; }
    .ssloading { position: absolute; inset: 46px 0 46px; display: flex; flex-direction: column; gap: 12px;
                 align-items: center; justify-content: center; background: rgba(0,0,0,.72); z-index: 2; color: #fff; }
    .ssloading[hidden] { display: none; }
    .spinner { width: 42px; height: 42px; border: 4px solid #555; border-top-color: #6db6ff; border-radius: 50%; animation: spin .8s linear infinite; }
    .sserror { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3;
               max-width: 460px; padding: 14px 18px; background: #3a2020; border: 1px solid #a33; color: #ffd0d0; text-align: center; }
    .sserror[hidden] { display: none; }
    .cache-info { color: #9cc9a3; font-size: 13px; }
    .activity { max-width: 1100px; margin: 8px 0 14px; padding: 9px 10px; background: #1a1a1a; border: 1px solid #333; }
    .search-help { max-width: 1100px; margin: -4px 0 12px; color: var(--muted); font-size: 12px; }
    .dirty-indicator { font-size: 11px; padding: 3px 8px; border: 1px solid var(--warn); color: var(--warn); border-radius: 12px; background: rgba(236,154,60,.08); }
    button.btn-dirty { border-color: var(--warn); color: #fff; background: linear-gradient(180deg, #6f4a1b, #4c3313); box-shadow: 0 0 0 1px rgba(236,154,60,.25) inset; }
    button.btn-dirty:hover { background: linear-gradient(180deg, #7f5520, #5b3d17); }
    .activity-head { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .activity-head strong { margin-right: auto; }
    .activity-head span { color: #9cc9ff; font-size: 12px; }
    .activity-selection { color: var(--muted) !important; border: 1px solid var(--line); padding: 2px 8px; border-radius: 999px; }
    .operation-list { margin-top: 7px; color: #bbb; font-size: 12px; }
    .operation { padding: 3px 0; display: flex; gap: 8px; flex-wrap: wrap; }
    .operation span { color: #9cc9ff; }
    .operation-error { color: #ff9d9d; }
    .workflow-bars { margin-top: 8px; display: grid; gap: 6px; }
    .wf-row { display: grid; grid-template-columns: 110px minmax(0,1fr) auto; gap: 8px; align-items: center; font-size: 12px; }
    .wf-label { color: var(--muted); text-transform: uppercase; letter-spacing: .06em; font-size: 10px; }
    .wf-track { height: 8px; background: #12161c; border: 1px solid var(--line); position: relative; }
    .wf-track i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .25s; }
    .wf-track i.wf-on { background: var(--accent); }
    .wf-track i.wf-done { background: var(--ok); }
    .wf-track i.wf-err { background: #c55; }
    .wf-row em { color: var(--text); font-style: normal; font-family: ui-monospace, Consolas, monospace; font-size: 11px; }
    .pager { max-width: 1100px; display: flex; gap: 10px; align-items: center; margin: 12px 0; flex-wrap: wrap; }
    .pager span { color: #bbb; font-size: 13px; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .sspanel { width: 35%; overflow: auto; background: #161616; padding: 10px; border-left: 1px solid #333; }
    .sspanel[hidden] { display: none; }
    .sspanel pre { white-space: pre-wrap; font: 12px/1.4 system-ui, sans-serif; margin: 8px 0 0; }
    .error { color: #f66; }
    /* ---- spy / dossier theme ---- */
    :root { --bg: #111418; --panel: #1c2127; --panel2: #252a31; --line: #383e47; --text: #d3d8de; --muted: #8f99a8;
            --accent: #4c90f0; --accent-d: #2d72d2; --ok: #32a467; --warn: #ec9a3c; }
    :root[data-theme='midnight-command'] { --bg:#111418; --panel:#1c2127; --panel2:#252a31; --line:#383e47; --text:#d3d8de; --muted:#8f99a8; --accent:#4c90f0; --accent-d:#2d72d2; --ok:#32a467; --warn:#ec9a3c; }
    :root[data-theme='obsidian-blue'] { --bg:#0f141b; --panel:#17212b; --panel2:#1f2c38; --line:#304352; --text:#d2dbe5; --muted:#91a1b2; --accent:#3ea8ff; --accent-d:#2a7fc3; --ok:#41b883; --warn:#f0a74a; }
    :root[data-theme='graphite-amber'] { --bg:#171513; --panel:#231f1b; --panel2:#2d2721; --line:#463b2f; --text:#e0d7cd; --muted:#ab9f93; --accent:#d89a4a; --accent-d:#af7838; --ok:#4da473; --warn:#f0b25c; }
    :root[data-theme='aurora-steel'] { --bg:#10161a; --panel:#1a242c; --panel2:#22303a; --line:#334651; --text:#d4e1e7; --muted:#8ea3ad; --accent:#57b7c8; --accent-d:#39899a; --ok:#49a16a; --warn:#d9a554; }
    :root[data-theme='night-ops-green'] { --bg:#0e1511; --panel:#15211a; --panel2:#1d2d24; --line:#2e4738; --text:#d1dfd6; --muted:#8ea595; --accent:#4fbf82; --accent-d:#358c60; --ok:#56c98a; --warn:#d3a658; }
    :root[data-theme='deep-violet'] { --bg:#14131c; --panel:#201f2d; --panel2:#2a2938; --line:#403e55; --text:#d8d6e6; --muted:#9a95b0; --accent:#8a7df2; --accent-d:#665bc2; --ok:#50a67c; --warn:#cfa76a; }
    :root[data-theme='slate-cyan'] { --bg:#10181a; --panel:#192529; --panel2:#223135; --line:#365059; --text:#d1e1e4; --muted:#90a8ae; --accent:#55c6d8; --accent-d:#3495a6; --ok:#4eaf79; --warn:#d4ab5f; }
    :root[data-theme='iron-redline'] { --bg:#181312; --panel:#251b1a; --panel2:#302322; --line:#4a3533; --text:#e1d3d1; --muted:#ac9795; --accent:#d46c67; --accent-d:#ad4f4a; --ok:#4da277; --warn:#e0a95f; }
    :root[data-theme='carbon-gold'] { --bg:#151513; --panel:#21211c; --panel2:#2b2b24; --line:#434336; --text:#dddccf; --muted:#a4a38f; --accent:#c7aa59; --accent-d:#9b8240; --ok:#4da173; --warn:#ddb768; }
    :root[data-theme='arctic-shadow'] { --bg:#10131a; --panel:#192131; --panel2:#222c3f; --line:#34445f; --text:#d4dded; --muted:#92a1b8; --accent:#7ea8ff; --accent-d:#5d84d6; --ok:#53a789; --warn:#d7a86b; }
    body { font-family: Inter, 'Segoe UI', system-ui, sans-serif; background: var(--bg); color: var(--text); font-size: 14px; }
    .spy-header { display: flex; align-items: center; gap: 14px; margin: 0 0 14px; padding: 0 12px; height: 40px; max-width: 1100px;
                  border: 1px solid var(--line); background: var(--panel); font-size: 11px; text-transform: uppercase;
                  letter-spacing: .08em; color: var(--muted); }
    .spy-header b { color: #fff; font-size: 12px; letter-spacing: .1em; }
    .spy-header .stamp { margin-left: auto; color: var(--warn); border: 1px solid var(--warn); border-radius: 2px; padding: 1px 6px; font-size: 10px; }
    .spy-header .clock { font-family: ui-monospace, Consolas, monospace; color: var(--text); }
    .spy-header .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); }
    .theme-switch { margin-left: 6px; display: inline-flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); }
    .theme-switch label { letter-spacing: .08em; text-transform: uppercase; }
    .theme-switch select { height: 24px; padding: 2px 6px; min-width: 170px; font-size: 11px; }
    input, select { background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 2px; font-family: inherit; }
    input:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 0 3px rgba(76,144,240,.3); }
    button, .btn { background: var(--panel2); color: var(--text); border: 1px solid var(--line); border-radius: 2px; font-family: inherit; font-size: 12px; }
    button:hover, .btn:hover { background: #2f343c; border-color: #4a515c; }
    button#playAll, button[type=submit] { background: var(--accent-d); border-color: var(--accent-d); color: #fff; }
    button#playAll:hover, button[type=submit]:hover { background: var(--accent); }
    .card { background: var(--panel); border: 1px solid var(--line); border-left: 3px solid #4a515c; border-radius: 2px; transform: none; }
    .card:hover { border-color: var(--accent); transform: none; background: var(--panel2); }
    .card[data-ready='1'] { border-left-color: var(--ok); }
    .capture-date { color: var(--accent); font-family: ui-monospace, Consolas, monospace; }
    .url { font-family: ui-monospace, Consolas, monospace; }
    .capture-details { color: var(--muted); text-transform: uppercase; letter-spacing: .05em; font-size: 11px; }
    .activity { background: var(--panel); border-color: var(--line); border-radius: 2px; }
    .activity-head strong { text-transform: uppercase; letter-spacing: .08em; font-size: 11px; color: var(--muted); }
    .activity-head span, .operation span { color: var(--accent); }
    .preload-info, .cache-info { color: var(--muted); }
    .empty-state { color: var(--muted); }
    .ssbar { background: var(--panel); border-bottom: 1px solid var(--line); }
    .ssbar #ssInfo { background: var(--bg); border: 1px solid var(--line); border-radius: 2px; padding: 4px 10px; color: var(--text); font-family: ui-monospace, Consolas, monospace; }
    .ssmain { background: var(--bg); }
    .ssframe { border: 1px solid var(--line); border-top: 26px solid var(--panel2); border-radius: 2px; box-shadow: 0 8px 28px rgba(0,0,0,.55); }
    .ssreader { background: var(--panel); border: 1px solid var(--line); border-radius: 2px; color: var(--text); }
    .ssdesc { color: var(--accent); }
    .spinner { border-color: var(--line); border-top-color: var(--accent); }
    .panel-title { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 10px 0 6px; display: flex; gap: 8px; align-items: center; }
    .panel-title .clear { margin-left: auto; padding: 2px 8px; }
    .timeline { max-width: 1100px; background: var(--panel); border: 1px solid var(--line); padding: 4px 12px 10px; margin-bottom: 12px; }
    .tl-bars { display: flex; gap: 4px; align-items: flex-end; height: 84px; overflow-x: auto; }
    .tl-bar { flex: 1 0 34px; max-width: 70px; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: stretch; text-decoration: none; position: relative; }
    .tl-fill { display: block; background: #3a5f93; border-radius: 1px 1px 0 0; margin-bottom: 14px; }
    .tl-bar:hover .tl-fill, .tl-bar.on .tl-fill { background: var(--accent); }
    .tl-label { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; font-size: 10px; color: var(--muted); font-family: ui-monospace, Consolas, monospace; }
    .tl-bar.on .tl-label { color: #fff; }
    .workspace { display: grid; grid-template-columns: 200px minmax(0, 1fr) 260px; gap: 14px; align-items: start; max-width: 1600px; }
    .facets, .inspector { background: var(--panel); border: 1px solid var(--line); padding: 4px 12px 12px; position: sticky; top: 8px; max-height: calc(100vh - 16px); overflow: auto; }
    .facets ul { list-style: none; margin: 0; padding: 0; }
    .facet { display: flex; justify-content: space-between; gap: 8px; padding: 3px 6px; color: var(--text); text-decoration: none; font-size: 12px; border-left: 2px solid transparent; }
    .facet:hover { background: var(--panel2); }
    .facet.on { border-left-color: var(--accent); background: var(--panel2); color: #fff; }
    .facet em { color: var(--muted); font-style: normal; font-family: ui-monospace, Consolas, monospace; }
    .facet span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .density { margin-bottom: 6px; }
    .capture-list.compact { gap: 0; }
    .capture-list.compact .card { border-radius: 0; border-top-width: 0; }
    .capture-list.compact .meta { padding: 3px 10px; grid-template-columns: 140px minmax(0, 1fr) auto auto; }
    .capture-list.compact .capture-details { grid-column: auto; }
    .capture-list.compact .meta .row { grid-column: auto; grid-row: auto; }
    .card.selected { border-color: var(--accent); background: var(--panel2); }
    .insp-empty { color: var(--muted); font-size: 12px; }
    .inspector dl { margin: 0; font-size: 12px; }
    .inspector dt { color: var(--muted); text-transform: uppercase; font-size: 10px; letter-spacing: .06em; margin-top: 8px; }
    .inspector dd { margin: 2px 0 0; word-break: break-all; font-family: ui-monospace, Consolas, monospace; }
    .hist { list-style: none; margin: 0; padding: 0; font-size: 12px; font-family: ui-monospace, Consolas, monospace; }
    .hist li { padding: 2px 4px; border-left: 2px solid var(--line); }
    .hist li.cur { border-left-color: var(--accent); color: #fff; background: var(--panel2); }
    .hist em { color: var(--muted); font-style: normal; }
    @@media (max-width: 1100px) { .workspace { grid-template-columns: 1fr; } .facets, .inspector { position: static; max-height: none; } }
    @@media (max-width: 700px) {
      body { padding: 8px; }
      .meta { grid-template-columns: 1fr; gap: 6px; }
      .capture-details, .meta .row { grid-column: 1; grid-row: auto; }
      .meta .row { flex-wrap: wrap; }
      .ssmain { flex-direction: column; }
      .ssframe { min-height: 55vh; }
      .sspanel { width: auto; height: 35vh; border-left: 0; border-top: 1px solid #333; }
      .sshint { display: none; }
      .jump input { width: 105px; }
      .theme-switch { width: 100%; margin-left: 0; }
      .theme-switch select { width: 100%; }
    }
  </style>
</head>
<body>
  <header class="spy-header" role="banner">
    <span class="dot" aria-hidden="true"></span>
    <b>Wayback // Archive Intercept</b>
    <span>Secure channel established</span>
    <span class="clock" id="spyClock" aria-hidden="true"></span>
    <span class="theme-switch">
      <label for="themeSelect">Theme</label>
      <select id="themeSelect" aria-label="UI theme">
        <option value="midnight-command">Midnight Command</option>
        <option value="obsidian-blue">Obsidian Blue</option>
        <option value="graphite-amber">Graphite Amber</option>
        <option value="aurora-steel">Aurora Steel</option>
        <option value="night-ops-green">Night Ops Green</option>
        <option value="deep-violet">Deep Violet</option>
        <option value="slate-cyan">Slate Cyan</option>
        <option value="iron-redline">Iron Redline</option>
        <option value="carbon-gold">Carbon Gold</option>
        <option value="arctic-shadow">Arctic Shadow</option>
      </select>
    </span>
    <span class="stamp" aria-hidden="true">Archive Ops</span>
  </header>
  <script>
    (function () {
      var c = document.getElementById('spyClock');
      var themeSelect = document.getElementById('themeSelect');
      var storageKey = 'wb-theme';
      var defaultTheme = 'midnight-command';

      function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme || defaultTheme);
      }

      var saved = localStorage.getItem(storageKey) || defaultTheme;
      applyTheme(saved);
      if (themeSelect) {
        themeSelect.value = saved;
        themeSelect.addEventListener('change', function () {
          var selected = themeSelect.value || defaultTheme;
          applyTheme(selected);
          localStorage.setItem(storageKey, selected);
        });
      }

      function t() { c.textContent = new Date().toISOString().replace('T', ' ').slice(0, 19) + 'Z'; }
      t(); setInterval(t, 1000);
    })();
  </script>
  @RenderBody()
</body>
</html>
