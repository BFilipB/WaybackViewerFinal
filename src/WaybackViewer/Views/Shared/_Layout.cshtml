<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"]</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; padding: 16px; background: #111; color: #eee; }
    .bar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; align-items: center; }
    input, select { padding: 6px; background: #222; color: #eee; border: 1px solid #444; }
    button, .btn { padding: 6px 10px; background: #2a2a2a; color: #eee; border: 1px solid #555;
                   cursor: pointer; text-decoration: none; font-size: 13px; }
    button:hover, .btn:hover { background: #3a3a3a; }
    .capture-list { display: flex; flex-direction: column; gap: 6px; max-width: 1100px; }
    .card { background: #1c1c1c; border: 1px solid #333; display: flex; }
    .card[hidden] { display: none; }
    .meta { width: 100%; padding: 8px 10px; display: grid; grid-template-columns: 150px minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; font-size: 12px; }
    .capture-date { color: #bbb; white-space: nowrap; }
    .url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .capture-details { color: #999; grid-column: 2; }
    .row { display: flex; gap: 6px; }
    .meta .row { grid-column: 3; grid-row: 1 / span 2; }
    .ss { position: fixed; inset: 0; background: #000; z-index: 100; display: flex; flex-direction: column; }
    .ss[hidden] { display: none; }
    .ssbar { display: flex; gap: 10px; align-items: center; padding: 8px 12px; background: #1a1a1a; flex-wrap: wrap; }
    .ssbar #ssInfo { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
    .jump { display: flex; gap: 5px; align-items: center; font-size: 12px; white-space: nowrap; }
    .jump input { width: 125px; padding: 5px; }
    .sshint { font-size: 12px; color: #999; }
    #expStatus { color: #9cc9ff; font-size: 12px; }
    .ssmain { flex: 1; display: flex; min-height: 0; }
    .ssframe { flex: 1; min-width: 0; border: 0; background: #fff; }
    .ssframe[hidden] { display: none; }
    .capture-row { content-visibility: auto; contain-intrinsic-size: auto 58px; }
    .ssreader { flex: 1; min-width: 0; overflow: auto; padding: 18px 26px; background: #161616; }
    .ssreader[hidden] { display: none; }
    .ssreader h2 { margin: 0 0 8px; font-size: 19px; }
    .ssdesc { color: #9cc9ff; margin: 0 0 14px; }
    .ssreader pre { white-space: pre-wrap; font: 14px/1.55 system-ui, sans-serif; margin: 0; max-width: 900px; }
    .empty-state { color: #aaa; max-width: 640px; line-height: 1.5; }
    .ssloading { position: absolute; inset: 46px 0 46px; display: flex; flex-direction: column; gap: 12px;
                 align-items: center; justify-content: center; background: rgba(0,0,0,.72); z-index: 2; color: #fff; }
    .ssloading[hidden] { display: none; }
    .spinner { width: 42px; height: 42px; border: 4px solid #555; border-top-color: #6db6ff; border-radius: 50%; animation: spin .8s linear infinite; }
    .sserror { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3;
               max-width: 460px; padding: 14px 18px; background: #3a2020; border: 1px solid #a33; color: #ffd0d0; text-align: center; }
    .sserror[hidden] { display: none; }
    .cache-info { color: #9cc9a3; font-size: 13px; }
    .activity { max-width: 1100px; margin: 8px 0 14px; padding: 9px 10px; background: #1a1a1a; border: 1px solid #333; }
    .activity-head { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .activity-head strong { margin-right: auto; }
    .activity-head span { color: #9cc9ff; font-size: 12px; }
    .operation-list { margin-top: 7px; color: #bbb; font-size: 12px; }
    .operation { padding: 3px 0; display: flex; gap: 8px; flex-wrap: wrap; }
    .operation span { color: #9cc9ff; }
    .operation-error { color: #ff9d9d; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .sspanel { width: 35%; overflow: auto; background: #161616; padding: 10px; border-left: 1px solid #333; }
    .sspanel[hidden] { display: none; }
    .sspanel pre { white-space: pre-wrap; font: 12px/1.4 system-ui, sans-serif; margin: 8px 0 0; }
    .error { color: #f66; }
    @@media (max-width: 700px) {
      body { padding: 8px; }
      .meta { grid-template-columns: 1fr; gap: 6px; }
      .capture-details, .meta .row { grid-column: 1; grid-row: auto; }
      .meta .row { flex-wrap: wrap; }
      .ssmain { flex-direction: column; }
      .ssframe { min-height: 55vh; }
      .sspanel { width: auto; height: 35vh; border-left: 0; border-top: 1px solid #333; }
      .sshint { display: none; }
      .jump input { width: 105px; }
    }
  </style>
</head>
<body>
  @RenderBody()
</body>
</html>
