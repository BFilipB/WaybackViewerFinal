	<body>
		<header class="spy-header" role="banner">
			<span class="dot" aria-hidden="true"></span>
			<b>Wayback // Archive Intercept</b>
			<nav class="site-nav" aria-label="Main"><a href="/">Home</a><a href="/urls">Searched URLs</a><a href="/operations">Operations</a><a href="/about">About</a></nav>
			<span>Secure channel established</span>
			<span class="clock" id="spyClock" aria-hidden="true"></span>
			<span class="theme-switch">
				<label for="themeSelect">Theme</label>
				<select id="themeSelect" aria-label="UI theme">
					<option value="midnight-command">Midnight Command</option><option value="clean-light">Clean Light</option><option value="archive-paper">Archive Paper</option><option value="neon-terminal">Neon Terminal</option><option value="high-contrast">High Contrast</option>
					<option value="obsidian-blue">Obsidian Blue</option>
					<option value="graphite-amber">Graphite Amber</option>
					<option value="aurora-steel">Aurora Steel</option>
					<option value="night-ops-green">Night Ops Green</option>
					<option value="deep-violet">Deep Violet</option>
					<option value="slate-cyan">Slate Cyan</option>
					<option value="iron-redline">Iron Redline</option>
					<option value="carbon-gold">Carbon Gold</option>
					<option value="arctic-shadow">Arctic Shadow</option>
				</select>
				<label for="layoutSelect">Layout</label>
				<select id="layoutSelect" aria-label="Page layout">
					<option value="classic">Classic</option>
					<option value="focus">Focus (list only)</option>
					<option value="wide">Wide</option>
					<option value="compact">Compact</option><option value="cards">Cards</option><option value="split">Split view</option><option value="timeline">Timeline</option>
				</select>
				<label for="motionSelect">Motion</label><select id="motionSelect" aria-label="Motion"><option value="rich">Rich</option><option value="subtle">Subtle</option><option value="none">None</option></select><label for="soundToggle">Sound</label><input type="checkbox" id="soundToggle" aria-label="Play a sound when an operation finishes" />
			</span>
			<span class="stamp" aria-hidden="true">Archive Ops</span>
		</header>
		<script>
			(function () {
			var c = document.getElementById('spyClock');
			var themeSelect = document.getElementById('themeSelect');
			var storageKey = 'wb-theme';
			var defaultTheme = (window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches) ? 'clean-light' : 'midnight-command';

			function applyTheme(theme) {
			document.documentElement.setAttribute('data-theme', theme || defaultTheme);
			}

			var saved = localStorage.getItem(storageKey) || defaultTheme;
			applyTheme(saved);
			var layoutSelect = document.getElementById('layoutSelect');
			var layoutKey = 'wb-layout';
			var savedLayout = localStorage.getItem(layoutKey) || 'classic';
			function applyLayout(layout) { document.documentElement.setAttribute('data-layout', layout || 'classic'); }
			applyLayout(savedLayout);
			if (layoutSelect) {
			layoutSelect.value = savedLayout;
			layoutSelect.addEventListener('change', function () {
			var chosen = layoutSelect.value || 'classic';
			applyLayout(chosen);
			localStorage.setItem(layoutKey, chosen);
			});
			}
			if (themeSelect) {
			themeSelect.value = saved;
			themeSelect.addEventListener('change', function () {
			var selected = themeSelect.value || defaultTheme;
			applyTheme(selected);
			localStorage.setItem(storageKey, selected);
			});
			}

			function t() { if (c) c.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }); }
			t(); setInterval(function () { if (!document.hidden) t(); }, 30000);

			function cycle(select, step) {
			if (!select || !select.options.length) return;
			select.selectedIndex = (select.selectedIndex + step + select.options.length) % select.options.length;
			select.dispatchEvent(new Event('change'));
			}
			document.addEventListener('keydown', function (e) {
			if (!e.altKey || e.ctrlKey || e.metaKey) return;
			var tag = (e.target && e.target.tagName) || '';
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
			if (e.key === 't' || e.key === 'T') { cycle(themeSelect, e.shiftKey ? -1 : 1); e.preventDefault(); }
			else if (e.key === 'l' || e.key === 'L') { cycle(layoutSelect, e.shiftKey ? -1 : 1); e.preventDefault(); }
			});
			})();
		</script>
		@RenderBody()
<script>
(function () {
// Live operation events (SSE); pages that poll slow down while connected. Opt-in completion sounds.
var live = window.wbLive = { connected: false };
var toggle = document.getElementById('soundToggle');
var soundKey = 'wb-sound';
try { if (toggle) toggle.checked = localStorage.getItem(soundKey) === '1'; } catch (e) { }
var lastBeep = 0, ctx = null;
function beep(freq) {
try {
ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
var o = ctx.createOscillator(), g = ctx.createGain();
o.frequency.value = freq; g.gain.value = 0.05; o.connect(g); g.connect(ctx.destination);
o.start(); o.stop(ctx.currentTime + 0.15);
} catch (e) { }
}
if (toggle) toggle.addEventListener('change', function () { try { localStorage.setItem(soundKey, toggle.checked ? '1' : '0'); } catch (e) { } if (toggle.checked) beep(660); });
function sound(ev) {
if (!toggle || !toggle.checked || document.visibilityState !== 'visible' || !ev.terminal) return;
var now = Date.now(); if (now - lastBeep < 2000) return; lastBeep = now;
beep(ev.state === 'Failed' ? 220 : ev.failed > 0 ? 440 : 880);
}
if (!window.EventSource) return;
// The live stream is open only while the tab is visible; closing it releases the stream buffers in the browser.
var es = null;
function onEvent(m) { var ev; try { ev = JSON.parse(m.data); } catch (e) { return; } window.dispatchEvent(new CustomEvent('wb-operation', { detail: ev })); sound(ev); }
function openLive() { if (es) return; es = new EventSource('/operations/events'); es.onopen = function () { live.connected = true; }; es.onerror = function () { live.connected = false; }; es.addEventListener('operation', onEvent); }
function closeLive() { if (!es) return; es.close(); es = null; live.connected = false; }
document.addEventListener('visibilitychange', function () { if (document.hidden) closeLive(); else openLive(); });
window.addEventListener('pagehide', closeLive);
if (!document.hidden) openLive();
})();
</script>	<script>(function(){var s=document.getElementById('motionSelect');if(!s)return;s.value=document.documentElement.getAttribute('data-motion')||'subtle';s.addEventListener('change',function(){document.documentElement.setAttribute('data-motion',s.value);try{localStorage.setItem('wb-motion',s.value);}catch(e){}});})();</script>
