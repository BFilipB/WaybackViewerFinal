			.capture-list:not(.compact) .popularity-badges { grid-area: badges; }
			.conf { font-size: .75em; padding: 0 .4em; border-radius: .6em; border: 1px solid currentColor; }
			.conf-high { color: #2a7a2a; } .conf-med { color: #9a7400; } .conf-low { color: #777; }
			.capture-list:not(.compact) .meta .row { grid-area: actions; grid-column: auto; grid-row: auto; align-self: center; }
			.popularity-badges { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 11px; color: var(--muted); }
			.meta .row { flex-wrap: nowrap; }
			.meta .row .btn, .meta .row button { white-space: nowrap; }
			.capture-list.compact .popularity-badges { display: none; }
			/* stack by the card's own width (the side panels can make it narrow on any screen) */
			.capture-row { container-type: inline-size; }
			@@container (max-width: 560px) {
			.capture-list:not(.compact) .meta { grid-template-columns: minmax(0, 1fr); grid-template-areas: "date" "url" "details" "badges" "actions"; }
			.capture-list:not(.compact) .meta .row { align-self: start; flex-wrap: wrap; }
			}
			/* grid of narrow cards: stack the card, buttons get their own full-width row */
			:root[data-layout='cards'] .capture-list:not(.compact) .meta { grid-template-columns: minmax(0, 1fr); grid-template-areas: "date" "url" "details" "badges" "actions"; }
			:root[data-layout='cards'] .capture-list:not(.compact) .meta .row { align-self: start; flex-wrap: wrap; }
			:root[data-layout='cards'] .capture-list:not(.compact) .url { white-space: normal; overflow-wrap: anywhere; }
			@@media (max-width: 700px) {
			.capture-list:not(.compact) .meta { grid-template-columns: minmax(0, 1fr); grid-template-areas: "date" "url" "details" "badges" "actions"; }
			.capture-list:not(.compact) .meta .row { align-self: start; flex-wrap: wrap; }
			}
			.insp-empty { color: var(--muted); font-size: 12px; }
			.inspector dl { margin: 0; font-size: 12px; }
			.inspector dt { color: var(--muted); text-transform: uppercase; font-size: 10px; letter-spacing: .06em; margin-top: 8px; }
			.inspector dd { margin: 2px 0 0; word-break: break-all; font-family: var(--font-mono); }
			.hist { list-style: none; margin: 0; padding: 0; font-size: 12px; font-family: var(--font-mono); }
			.hist li { padding: 2px 4px; border-left: 2px solid var(--line); }
			.hist li.cur { border-left-color: var(--accent); color: #fff; background: var(--panel2); }
			.hist em { color: var(--muted); font-style: normal; }
			@@media (max-width: 1100px) { .workspace { grid-template-columns: 1fr; } .facets, .inspector { position: static; max-height: none; } }
			@@media (max-width: 700px) {
			body { padding: 8px; }
			.meta { grid-template-columns: 1fr; gap: 6px; }
			.capture-details, .meta .row { grid-column: 1; grid-row: auto; }
			.meta .row { flex-wrap: wrap; }
			.ssmain { flex-direction: column; }
			.ssframe { min-height: 55vh; }
			.sspanel { width: auto; height: 35vh; border-left: 0; border-top: 1px solid #333; }
			.sshint { display: none; }
			.jump input { width: 105px; }
			.theme-switch { width: 100%; margin-left: 0; }
			.theme-switch select { width: 100%; }
