@model OperationsPageModel
@{
	ViewData["Title"] = "Operations";
	string Qs(int page, string? state, string? type)
	{
		var parts = new List<string> { "page=" + page, "pageSize=" + Model.PageSize };
		if (state is not null) parts.Add("state=" + Uri.EscapeDataString(state));
		if (type is not null) parts.Add("type=" + Uri.EscapeDataString(type));
		if (!string.IsNullOrEmpty(Model.Search)) parts.Add("q=" + Uri.EscapeDataString(Model.Search));
		parts.Add("sort=" + Model.Sort);
		parts.Add("dir=" + (Model.Descending ? "desc" : "asc"));
		return "/operations?" + string.Join("&", parts);
	}
	string Eta(double? seconds) => seconds is null ? "–" : TimeSpan.FromSeconds(seconds.Value).ToString(seconds.Value >= 3600 ? @"h\:mm\:ss" : @"m\:ss");
	string Bar(BackgroundOperation? op) => op is null ? "" : op.State switch
	{
		OperationState.Failed => "wf-err",
		OperationState.Completed or OperationState.CompletedWithFailures => "wf-done",
		_ => "wf-on"
	};
	string Count(BackgroundOperation? op) => op is null ? "–" : $"{op.Completed}/{op.Total}";
	var states = new[] { (null as string, "All states"), ("active", "Active"), ("paused", "Paused"), ("completed", "Completed"), ("failures", "With failures") };
	var types = new[] { (null as string, "All types"), ("captureload", "Capture list"), ("preload", "Page preload") };
}

<section class="ops-page">
  <h1>Operations</h1>
  <p class="ops-help">Background work for every searched URL. Capture-list loads and page preloads run independently; active URLs share the download workers fairly.</p>

  <div class="ops-controls">
  <form method="get" action="/operations" autocomplete="off" class="ops-filters" role="search">
    <input type="search" name="q" value="@Model.Search" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="200" placeholder="Search URL or filter" aria-label="Search operations" />
    <select name="sort" aria-label="Sort by">
      <option value="updated" selected="@(Model.Sort == "updated")">Last updated</option>
      <option value="url" selected="@(Model.Sort == "url")">URL</option>
      <option value="state" selected="@(Model.Sort == "state")">State</option>
    </select>
    <select name="dir" aria-label="Sort direction">
      <option value="desc" selected="@Model.Descending">Descending</option>
      <option value="asc" selected="@(!Model.Descending)">Ascending</option>
    </select>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    @if (Model.StateFilter is not null) { <input type="hidden" name="state" value="@Model.StateFilter" /> }
    @if (Model.TypeFilter is not null) { <input type="hidden" name="type" value="@Model.TypeFilter" /> }
    <button type="submit">Apply</button>
    @if (!string.IsNullOrEmpty(Model.Search)) { <a href="@(Qs(1, Model.StateFilter, Model.TypeFilter).Replace("q=" + Uri.EscapeDataString(Model.Search) + "&", ""))">Clear</a> }
  </form>
  <nav class="ops-filters" aria-label="Filter operations">
	@foreach (var (value, label) in states)
	{
	  <a href="@Qs(1, value, Model.TypeFilter)" class="@(value == Model.StateFilter ? "on" : "")">@label</a>
	}
	<span class="sep">|</span>
	@foreach (var (value, label) in types)
	{
	  <a href="@Qs(1, Model.StateFilter, value)" class="@(value == Model.TypeFilter ? "on" : "")">@label</a>
	}
  </nav>
  </div>

  <div class="ops-bulk" id="opsBulk" data-state="@Model.StateFilter" data-type="@Model.TypeFilter" data-q="@Model.Search" data-total="@Model.Total">
	<span id="opsSelected" class="ops-selected" aria-live="polite">0 selected</span>
	<button type="button" data-bulk="pause" disabled>Pause</button>
	<button type="button" data-bulk="resume" disabled>Resume</button>
	<button type="button" data-bulk="retry-failed" disabled>Retry failed</button>
	<button type="button" data-bulk="refresh" disabled>Refresh</button>
	<span id="opsMessage" aria-live="polite"></span>
  </div>
  <div class="ops-banner" id="opsBanner" hidden>
	<span id="opsBannerText"></span>
	<button type="button" id="opsSelectMatching"></button>
	<button type="button" id="opsClearSelection" hidden>Clear selection</button>
  </div>

  @if (Model.Rows.Count == 0)
  {
	<p class="ops-empty">No operations match.</p>
  }
  else
  {
	<div class="table-scroll"><table class="ops-table" id="opsTable">
	  <colgroup><col style="width:28px"><col><col style="width:92px"><col style="width:96px"><col style="width:96px"><col class="hide-sm" style="width:56px"><col class="hide-lg" style="width:56px"><col class="hide-sm" style="width:52px"><col class="hide-md" style="width:56px"><col class="hide-lg" style="width:56px"><col class="hide-lg" style="width:56px"><col class="hide-md" style="width:120px"><col style="width:400px"></colgroup>
	  <thead>
		<tr>
		  <th><input type="checkbox" id="opsAll" aria-label="Select all rows on this page" /></th>
		  <th>URL</th><th>State</th><th>Capture list</th><th>Page preload</th>
		  <th class="hide-sm">Saved</th><th class="hide-lg">Skipped</th><th class="hide-sm">Failed</th><th class="hide-md">Pending</th><th class="hide-lg">Speed</th><th class="hide-lg">ETA</th><th class="hide-md">Last error</th><th>Actions</th>
		</tr>
	  </thead>
	  <tbody>
		@foreach (var row in Model.Rows)
		{
		  <tr data-prefix="@row.Prefix" data-filter="@row.Filter">
			<td><input type="checkbox" class="ops-pick" aria-label="Select @row.Prefix" /></td>
			<td class="ops-url cell-clip" title="@row.Prefix @row.Filter"><a href="/?url=@Uri.EscapeDataString(row.Prefix)&amp;filter=@Uri.EscapeDataString(row.Filter)">@row.Prefix</a> <small>@row.Filter</small></td>
			<td><span class="ops-badge ops-@row.State.ToLowerInvariant()" data-f="state">@row.State</span></td>
			<td><div class="wf-track"><i class="@Bar(row.CaptureLoad)" data-f="captureBar" style="width:@(row.CapturePercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div><small data-f="captureText">@Count(row.CaptureLoad)</small></td>
			<td><div class="wf-track"><i class="@Bar(row.Preload)" data-f="preloadBar" style="width:@(row.PreloadPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div><small data-f="preloadText">@Count(row.Preload)</small></td>
			<td class="hide-sm" data-f="saved">@row.Saved</td>
			<td class="hide-lg" data-f="skipped">@(row.Skipped?.ToString() ?? "–")</td>
			<td class="hide-sm" data-f="failed">@row.Failed</td>
			<td class="hide-md" data-f="pending">@row.Pending</td>
			<td class="hide-lg" data-f="speed">@(row.PerSecond > 0 ? row.PerSecond + "/s" : "–")</td>
			<td class="hide-lg" data-f="eta">@Eta(row.EtaSeconds)</td>
			<td class="operation-error cell-clip hide-md" data-f="error" title="@row.LastError">@row.LastError</td>
			<td class="ops-actions">
			  <button type="button" data-row="@(row.Paused ? "resume" : "pause")">@(row.Paused ? "Resume" : "Pause")</button>
			  <button type="button" data-row="retry-failed" title="Retry failed pages">Retry</button>
			  <button type="button" data-row="refresh" title="Refresh the capture list">Refresh</button>
			  <button type="button" data-delete="pages" title="Delete the preloaded pages; the capture list stays">Delete pages</button>
              <button type="button" data-delete="all" title="Delete everything stored for this URL">Delete all</button>
			</td>
		  </tr>
		}
	  </tbody>
	</table></div>
  }

  <div class="pager">
	@if (Model.Page > 1) { <a href="@Qs(Model.Page - 1, Model.StateFilter, Model.TypeFilter)">« Prev</a> }
	<span>Page @Model.Page of @Model.PageCount · @Model.Total URLs</span>
	@if (Model.Page < Model.PageCount) { <a href="@Qs(Model.Page + 1, Model.StateFilter, Model.TypeFilter)">Next »</a> }
  </div>
</section>

<style>
  .ops-page { max-width: none; }
  .ops-help { color: var(--muted); }
  .ops-filters, .ops-bulk { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 8px 0; }
  .ops-filters a.on { font-weight: bold; text-decoration: underline; }
  .ops-table .wf-track { width: 80px; }
  #opsTable { width: 100%; table-layout: fixed; font-size: 12px; }
  #opsTable th, #opsTable td { padding: 4px 5px; }
  #opsTable td { overflow: hidden; text-overflow: ellipsis; }
  #opsTable .wf-track { width: 100%; }
  #opsTable td.ops-actions { white-space: nowrap; overflow: visible; }
  .ops-actions button { padding: 2px 5px; font-size: 11px; margin: 0 2px 0 0; white-space: nowrap; }
  .ops-badge { padding: 1px 7px; border-radius: 999px; border: 1px solid var(--line); }
  .ops-running, .ops-queued { color: var(--accent); }
  .ops-completed { color: var(--ok); }
  .ops-failed, .ops-completedwithfailures { color: #ff9d9d; }
  .ops-paused { color: var(--muted); }
  .ops-controls { border: 1px solid var(--line); border-radius: 8px; padding: 4px 10px; margin: 8px 0; }
  .ops-controls .ops-filters { margin: 4px 0; }
  .ops-selected { font-weight: bold; min-width: 90px; }
  .ops-bulk button:disabled { opacity: .45; cursor: not-allowed; }
  .ops-banner { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 6px 10px; margin: 6px 0; border: 1px solid var(--line); border-radius: 6px; font-size: 12px; }
  .ops-banner[hidden] { display: none; }
  .ops-banner button { background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; cursor: pointer; font: inherit; }
</style>

<script>
(() => {
  const token = () => document.querySelector('meta[name="request-verification-token"]')?.content || '';
  const table = document.getElementById('opsTable');
  const message = document.getElementById('opsMessage');
  const selectedInfo = document.getElementById('opsSelected');
  const rows = () => table ? [...table.tBodies[0].rows] : [];
  const key = tr => ({ prefix: tr.dataset.prefix, filter: tr.dataset.filter });
  const selected = () => rows().filter(tr => tr.querySelector('.ops-pick').checked).map(key);

  async function post(action, body) {
	const response = await fetch('/operations/' + action, {
	  method: 'POST',
	  headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': token() },
	  body: JSON.stringify(body)
	});
	if (!response.ok) throw new Error('HTTP ' + response.status);
	return response.json();
  }

  async function run(action, body) {
	message.textContent = 'Working...';
	try {
	  const result = await post(action, body);
	  message.textContent = 'Applied to ' + result.applied + ' URL(s).' + (result.capped ? ' Limit reached - run it again for the rest.' : '');
	  refresh();
	} catch (e) { message.textContent = 'Action failed (' + e.message + ').'; }
  }

  const bulk = document.getElementById('opsBulk');
  const banner = document.getElementById('opsBanner');
  const bannerText = document.getElementById('opsBannerText');
  const selectMatching = document.getElementById('opsSelectMatching');
  const clearSelection = document.getElementById('opsClearSelection');
  const master = document.getElementById('opsAll');
  const total = Number(bulk.dataset.total || 0);
  const scope = () => ({ state: bulk.dataset.state || null, type: bulk.dataset.type || null, search: bulk.dataset.q || null });

  // The selection survives paging: it is kept in sessionStorage per search/filter scope.
  // matching: every URL matching the scope (all pages) is selected. picked: explicit rows, any page.
  const storeKey = 'opsSel:' + JSON.stringify(scope());
  const MAX_PICKED = 1000;
  let sel = { matching: false, picked: {} };
  try { const s = JSON.parse(sessionStorage.getItem(storeKey) || 'null'); if (s && typeof s.picked === 'object') sel = { matching: !!s.matching, picked: s.picked }; } catch (err) { console.warn('saved selection ignored', err); }
  const save = () => { try { sessionStorage.setItem(storeKey, JSON.stringify(sel)); } catch (e) { console.warn('selection not persisted', e); } };
  const id = k => k.prefix + '\n' + k.filter;
  const pickedCount = () => Object.keys(sel.picked).length;

  function syncChecks() {
	rows().forEach(tr => { tr.querySelector('.ops-pick').checked = sel.matching || id(key(tr)) in sel.picked; });
  }

  function updateSelection() {
	const onPage = rows().length;
	const onPageChecked = selected().length;
	const count = sel.matching ? total : pickedCount();
	if (master) { master.checked = onPage > 0 && onPageChecked === onPage; master.indeterminate = onPageChecked > 0 && onPageChecked < onPage; }
	selectedInfo.textContent = count + ' selected' + (!sel.matching && count > onPageChecked ? ' (across pages)' : '');
	document.querySelectorAll('[data-bulk]').forEach(b => { b.disabled = count === 0; });
	const offer = !sel.matching && onPage > 0 && onPageChecked === onPage && total > pickedCount();
	banner.hidden = !(sel.matching || offer || count > 0);
	selectMatching.hidden = !offer;
	clearSelection.hidden = count === 0;
	bannerText.textContent = sel.matching ? 'All ' + total + ' matching URLs (every page) are selected.'
	  : offer ? pickedCount() + ' selected. Select all ' + total + ' matching URLs on every page?'
	  : count > 0 ? count + ' selected (kept while you change pages).' : '';
	if (offer) selectMatching.textContent = 'Select all ' + total + ' matching URLs';
	save();
  }

  function setRow(tr, on) {
	const k = key(tr);
	if (on) { if (pickedCount() < MAX_PICKED) sel.picked[id(k)] = k; else message.textContent = 'At most ' + MAX_PICKED + ' rows can be ticked individually; use "Select all matching" instead.'; }
	else delete sel.picked[id(k)];
  }

  async function runSelected(action) {
	if (sel.matching) return run(action, { matching: scope() });
	const keys = Object.values(sel.picked);
	if (keys.length === 0) { message.textContent = 'Select at least one row.'; return; }
	message.textContent = 'Working...';
	try {
	  let applied = 0;
	  for (let i = 0; i < keys.length; i += 200) applied += (await post(action, { keys: keys.slice(i, i + 200) })).applied;
	  message.textContent = 'Applied to ' + applied + ' URL(s).';
	  refresh();
	} catch (e) { message.textContent = 'Action failed (' + e.message + ').'; }
  }

  document.querySelectorAll('[data-bulk]').forEach(btn => btn.addEventListener('click', () => runSelected(btn.dataset.bulk)));
  selectMatching.addEventListener('click', () => { sel.matching = true; sel.picked = {}; syncChecks(); updateSelection(); });
  clearSelection.addEventListener('click', () => { sel = { matching: false, picked: {} }; syncChecks(); updateSelection(); });
  if (table) {
	table.addEventListener('click', e => {
	  const btn = e.target.closest('[data-row]');
	  if (btn) run(btn.dataset.row, { keys: [key(btn.closest('tr'))] });
	});
	table.addEventListener('change', e => {
	  if (e.target.id === 'opsAll') return;
	  const tr = e.target.closest('tr'); if (!tr) return;
	  if (sel.matching) {
		// Un-ticking one row leaves "all matching": keep the other rows of this page as explicit picks.
		sel.matching = false; sel.picked = {};
		rows().forEach(r => { if (r === tr ? e.target.checked : true) setRow(r, true); });
	  }
	  setRow(tr, e.target.checked);
	  syncChecks(); updateSelection();
	});
	master?.addEventListener('change', e => {
	  if (sel.matching && !e.target.checked) sel = { matching: false, picked: {} };
	  else rows().forEach(tr => setRow(tr, e.target.checked));
	  syncChecks(); updateSelection();
	});
  }
  syncChecks();
  updateSelection();
  // Delete: ask the server what would be removed, confirm, then the delete runs as a background operation.
  async function confirmDelete(tr, level) {
    const k = key(tr);
    const p = await post('delete-preview', { key: k });
    const mb = (p.bytes / 1048576).toFixed(1);
    const what = level === 'all'
      ? 'Delete everything for ' + k.prefix + '? ' + p.captures + ' captures, ' + p.pages + ' saved pages (' + mb + ' MB) will be removed.'
      : 'Delete the ' + p.pages + ' preloaded pages (' + mb + ' MB) of ' + k.prefix + '? The capture list is kept.';
    const shared = p.sharedCaptures > 0 ? ' ' + p.sharedCaptures + ' captures also used by other URLs are kept.' : '';
    if (!window.confirm(what + shared)) return;
    message.textContent = 'Working...';
    await post('delete', { key: k, level });
    message.textContent = 'Delete started.';
    refresh();
  }
  if (table) table.addEventListener('click', e => {
    const btn = e.target.closest('[data-delete]');
    if (btn) confirmDelete(btn.closest('tr'), btn.dataset.delete).catch(err => { message.textContent = 'Delete failed (' + err.message + ').'; });
  });

  const set = (tr, f, v) => { const el = tr.querySelector('[data-f="' + f + '"]'); if (el) el.textContent = v; };
  const bar = (tr, f, op) => {
	const el = tr.querySelector('[data-f="' + f + '"]'); if (!el) return;
	const done = op && (op.state === 6 || op.state === 8);
	const pct = !op ? 0 : op.total > 0 ? Math.min(100, op.completed * 100 / op.total) : (done || op.state === 7 ? 100 : 0);
	el.style.width = pct + '%';
	el.className = !op ? '' : op.state === 7 ? 'wf-err' : done ? 'wf-done' : 'wf-on';
  };
  const eta = s => s == null ? '–' : (s >= 3600 ? Math.floor(s / 3600) + ':' : '') + String(Math.floor(s % 3600 / 60)).padStart(s >= 3600 ? 2 : 1, '0') + ':' + String(Math.floor(s % 60)).padStart(2, '0');

  // Polls the status of the visible rows only.
  async function refresh() {
	const visible = rows();
	if (visible.length === 0) return false;
	const status = await post('status', { keys: visible.map(key) });
	let active = false;
	status.forEach((r, i) => {
	  const tr = visible[i]; if (!tr) return;
	  const badge = tr.querySelector('[data-f="state"]');
	  badge.textContent = r.state; badge.className = 'ops-badge ops-' + r.state.toLowerCase();
	  bar(tr, 'captureBar', r.captureLoad); bar(tr, 'preloadBar', r.preload);
	  set(tr, 'captureText', r.captureLoad ? r.captureLoad.completed + '/' + r.captureLoad.total : '–');
	  set(tr, 'preloadText', r.preload ? r.preload.completed + '/' + r.preload.total : '–');
	  set(tr, 'saved', r.saved); set(tr, 'skipped', r.skipped ?? '–'); set(tr, 'failed', r.failed);
	  set(tr, 'pending', r.pending); set(tr, 'speed', r.perSecond > 0 ? r.perSecond + '/s' : '–');
	  set(tr, 'eta', eta(r.etaSeconds)); set(tr, 'error', r.lastError || '');
	  const toggle = tr.querySelector('[data-row="pause"],[data-row="resume"]');
	  toggle.dataset.row = r.paused ? 'resume' : 'pause'; toggle.textContent = r.paused ? 'Resume' : 'Pause';
	  active ||= r.active;
	});
	return active;
  }

  function setLive(ok) { if (ok) { if (message.dataset.live === 'lost') { message.textContent = ''; delete message.dataset.live; } } else { message.dataset.live = 'lost'; message.textContent = 'Connection lost - retrying...'; } }
  async function poll() {
	let active = true;
	let failed = false;
	try { active = await refresh(); setLive(true); } catch (err) { failed = true; setLive(false); console.warn('operations status poll failed', err); }
	setTimeout(poll, failed ? 10000 : window.wbLive && window.wbLive.connected ? 15000 : active ? 1500 : 5000);   // SSE connected: polling is only a safety net
  }
  let pending = false;
  window.addEventListener('wb-operation', () => { if (pending) return; pending = true; setTimeout(() => { pending = false; refresh().then(() => setLive(true), err => { setLive(false); console.warn('operations status refresh failed', err); }); }, 250); });
  poll();
})();
</script>
