@model CaptureListViewModel
@{
    ViewData["Title"] = "Wayback Viewer";
    var readyCount = Model.Captures.Count(c => c.Ready);
    var act = Model.Active ?? new CaptureFilter();
    string Qs(int p, string? year, string? cat, string? st, string? sec)
    {
        var s = "?url=" + Uri.EscapeDataString(Model.Url) + "&amp;filter=" + Uri.EscapeDataString(Model.Filter)
            + "&amp;pagination=" + Model.PaginationMode + "&amp;page=" + p + "&amp;pageSize=" + Model.PageSize + "&amp;searchMode=" + Uri.EscapeDataString(Model.SearchMode);
        if (year is not null) s += "&amp;year=" + Uri.EscapeDataString(year);
        if (cat is not null) s += "&amp;category=" + Uri.EscapeDataString(cat);
        if (st is not null) s += "&amp;status=" + Uri.EscapeDataString(st);
        if (sec is not null) s += "&amp;section=" + Uri.EscapeDataString(sec);
        if (act.Text is not null) s += "&amp;q=" + Uri.EscapeDataString(act.Text);
        return s;
    }
    string PageLink(int p) => Qs(p, act.Year, act.Category, act.Status, act.Section);
    string Toggle(string kind, string value) => Qs(1,
        kind == "year" ? (act.Year == value ? null : value) : act.Year,
        kind == "category" ? (act.Category == value ? null : value) : act.Category,
        kind == "status" ? (act.Status == value ? null : value) : act.Status,
        kind == "section" ? (act.Section == value ? null : value) : act.Section);
    bool IsOn(string kind, string value) => kind switch { "year" => act.Year == value, "category" => act.Category == value, "status" => act.Status == value, _ => act.Section == value };
}

<form id="searchBar" method="get" class="bar">
  <input name="url" value="@Model.Url" size="45" placeholder="example.com/blog/  (or paste a web.archive.org link)" />
  <select name="filter">
    <option value="html200" selected="@(Model.Filter == "html200")">HTML pages, status 200</option>
    <option value="html" selected="@(Model.Filter == "html")">HTML pages, any status</option>
    <option value="all" selected="@(Model.Filter == "all")">Everything (incl. images, redirects)</option>
  </select>
  <select name="pagination" aria-label="Pagination mode">
    <option value="server" selected="@(Model.PaginationMode == "server")">Server pagination (recommended)</option>
    <option value="client" selected="@(Model.PaginationMode == "client")">Client pagination (loads all)</option>
  </select>
  <select name="pageSize" aria-label="Captures per page">
    @foreach (var size in new[] { 25, 50, 100, 200 })
    {
      <option value="@size" selected="@(Model.PageSize == size)">@size per page</option>
    }
  </select>
  <select id="searchModeSelect" name="searchMode" aria-label="Search mode">
    <option value="url" selected="@(Model.SearchMode == "url")">Search URLs</option>
    <option value="content" selected="@(Model.SearchMode == "content")">Search content</option>
  </select>
  <input id="queryInput" name="q" value="@act.Text" size="28" placeholder="Optional filter keywords" aria-label="Search captures" />
  <button id="applyTextFilter" type="button" title="Apply current search text/mode to the current capture list">Apply filter</button>
  <span id="filterDirtyBadge" class="dirty-indicator" hidden>Unapplied filter changes</span>
  <button type="submit">Load captures</button>
  <button type="submit" name="refresh" value="true">Refresh from Wayback</button>
</form>
<p id="searchModeHelp" class="search-help" role="status"></p>

<section id="activity" class="activity" aria-live="polite">
  <div class="activity-head">
    <strong>Background activity</strong>
    <span id="activityImmediate">Ready</span>
    <span id="activitySelectionInfo" class="activity-selection">0 selected · 0 active</span>
    <button id="selectActiveOps" type="button">Select active</button>
    <button id="clearSelectedOps" type="button">Clear selection</button>
    <button id="pauseWork" type="button">Pause</button>
    <button id="resumeWork" type="button">Resume</button>
    <button id="stopWork" type="button">Stop</button>
  </div>
  <div class="workflow-bars" id="workflowBars">
    <div class="wf-row"><span class="wf-label">Capture list</span><div class="wf-track"><i id="captureBar" style="width:0%"></i></div><em id="captureText">Idle</em></div>
    <div class="wf-row"><span class="wf-label">Page preload</span><div class="wf-track"><i id="preloadBar" style="width:0%"></i></div><em id="preloadText">Idle</em></div>
  </div>
  <div id="workflowTimeline" class="operation-list">No workflow events yet.</div>
</section>

@if (Model.Error is not null)
{
  <p class="error">Error: @Model.Error</p>
}
else if (string.IsNullOrEmpty(Model.Url))
{
  <p class="empty-state">Enter any website address above (for example <code>example.com/blog/</code>) to list every
  page the Wayback Machine has captured under it. Captures, pages and extracted text are saved to a local SQLite database
  database, so the next time they load instantly.</p>
}
else if (Model.FromDatabase && Model.CachedAt is not null)
{
  <p class="cache-info">Loaded from the database: @Model.CachedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</p>
}
else if (Model.CachedAt is not null)
{
  <p class="cache-info">Loaded from Wayback and saved to the database: @Model.CachedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</p>
}

@if (Model.Captures.Count > 0)
{
  <p id="preloadStatus" class="preload-info" role="status">@readyCount of @(Model.PaginationMode == "server" ? Model.TotalCaptures : Model.Captures.Count) captures already saved in the database.</p>

  <div class="bar">
    <strong id="count">@(Model.PaginationMode == "server" ? $"Page {Model.Page} captures ({Model.TotalCaptures} total)" : $"{Model.Captures.Count} captures")</strong>
    <button id="playAll">&#9654; @(Model.PaginationMode == "server" ? "Show this page" : "Show all captures")</button>
    <button id="playAllAll" type="button" title="Open slideshow for every capture in current filters">Slideshow all (filtered)</button>
    <select id="expFmt">
      <option value="xls">Excel (.xls)</option>
      <option value="txt">txt</option>
      <option value="json">json</option>
      <option value="csv">csv</option>
    </select>
    <button id="expAll">@(Model.PaginationMode == "server" ? "Export this page" : "Export all text")</button>
    <button id="expAllFiltered" type="button" title="Export every filtered capture, not just the visible page">Export all (filtered)</button>
    <span id="expStatus"></span>
  </div>

@if (Model.TotalPages > 1)
{
  <nav class="pager" aria-label="Capture pages" id="serverPager" data-mode="@Model.PaginationMode">
    @if (Model.PaginationMode == "server")
    {
       @if (Model.Page > 1)
      {
          <a class="btn" aria-label="First capture page" href="@Html.Raw(PageLink(1))">First</a>
          <a class="btn" rel="prev" aria-label="Previous capture page" href="@Html.Raw(PageLink(Model.Page - 1))">Previous</a>
      }
       @if (Model.Page > 3)
       {
         <span aria-hidden="true">…</span>
       }
       @for (var pagerPage = Math.Max(1, Model.Page - 2); pagerPage <= Math.Min(Model.TotalPages, Model.Page + 2); pagerPage++)
       {
         if (pagerPage == Model.Page)
         {
           <span aria-current="page">@pagerPage</span>
         }
         else
         {
           <a class="btn" aria-label="Capture page @pagerPage" href="@Html.Raw(PageLink(pagerPage))">@pagerPage</a>
         }
       }
       @if (Model.Page < Model.TotalPages - 2)
       {
         <span aria-hidden="true">…</span>
       }
       @if (Model.Page < Model.TotalPages)
       {
          <a class="btn" rel="next" aria-label="Next capture page" href="@Html.Raw(PageLink(Model.Page + 1))">Next</a>
          <a class="btn" aria-label="Last capture page" href="@Html.Raw(PageLink(Model.TotalPages))">Last</a>
       }
    }
    else
    {
      <button id="clientPrev" type="button" aria-label="Previous capture page">Previous</button>
      <span id="clientPageInfo" tabindex="-1" aria-live="polite" aria-current="page">Page 1</span>
      <button id="clientNext" type="button" aria-label="Next capture page">Next</button>
    }
  </nav>
}
}

@if (Model.Facets is { Years.Count: > 0 } facets)
{
  var maxYear = Math.Max(1, facets.Years.Max(y => y.Count));
  <section class="timeline" aria-label="Capture timeline">
    <div class="panel-title">Timeline @if (act.IsActive) { <a class="btn clear" href="@Html.Raw(Qs(1, null, null, null, null))">Clear filters</a> }</div>
    <div class="tl-bars">
      @foreach (var y in facets.Years)
      {
        <a class="tl-bar @(IsOn("year", y.Value) ? "on" : "")" href="@Html.Raw(Toggle("year", y.Value))" title="@y.Value: @y.Count captures, @y.Saved saved">
          <span class="tl-fill" style="height:@(Math.Max(4, y.Count * 100 / maxYear))%"></span>
          <span class="tl-label">@y.Value</span>
        </a>
      }
    </div>
  </section>
}

<div class="workspace">
@if (Model.Facets is not null)
{
  <aside class="facets" aria-label="Filters">
    @foreach (var (title, kind, items) in new[] { ("Category", "category", Model.Facets.Categories), ("Status", "status", Model.Facets.Statuses), ("Section", "section", Model.Facets.Sections) })
    {
      if (items.Count == 0) { continue; }
      <div class="panel-title">@title</div>
      <ul>
        @foreach (var f in items)
        {
          <li><a class="facet @(IsOn(kind, f.Value) ? "on" : "")" href="@Html.Raw(Toggle(kind, f.Value))"><span>@f.Value</span><em>@f.Count</em></a></li>
        }
      </ul>
    }
  </aside>
}
<div class="main-col">
<div class="density"><button type="button" id="densityBtn">Compact view</button></div>
<div class="capture-list" id="captureList">
@foreach (var c in Model.Captures)
{
  <div class="card capture-row" data-key="@c.Capture.ArchiveUrl" data-ts="@c.Capture.Timestamp" data-url="@c.Capture.Original" data-ready="@(c.Ready ? "1" : "0")" data-frame="/Home/Frame?ts=@c.Capture.Timestamp&amp;url=@Uri.EscapeDataString(c.Capture.Original)">
    <div class="meta">
      <div class="capture-date">@c.Capture.Date.ToString("yyyy-MM-dd HH:mm")</div>
      <div class="url" title="@c.Capture.Original">@c.Capture.Original</div>
      <div class="capture-details">Status @c.Capture.StatusCode &middot; @c.Capture.MimeType</div>
      <div class="row">
        <a class="btn" href="@c.Capture.ArchiveUrl" target="_blank" rel="noopener">Open</a>
        <button class="view">View in slideshow</button>
      </div>
    </div>
  </div>
}
</div>
</div>
<aside class="inspector" id="inspector" aria-label="Capture details">
  <div class="panel-title">Inspector</div>
  <div id="inspBody" class="insp-empty">Select a capture to see its details and history.</div>
</aside>
</div>

<div id="ss" class="ss" hidden>
  <div class="ssbar">
    <span id="ssInfo"></span>
    <label class="jump">Jump to <input id="ssJump" type="text" inputmode="numeric" placeholder="# or timestamp" aria-label="Capture number or timestamp" /></label>
    <button id="ssJumpBtn">Go</button>
    <span class="sshint">&larr; &rarr; navigate &nbsp; F fast/full &nbsp; O open tab &nbsp; T text (full view) &nbsp; Esc close</span>
    <button id="ssMode">Full page (F)</button>
    <button id="ssClose">Close</button>
  </div>
  <div id="ssMain" class="ssmain">
    <div id="ssReader" class="ssreader" hidden>
      <h2 id="ssTitle"></h2>
      <p id="ssDesc" class="ssdesc"></p>
      <pre id="ssBody"></pre>
    </div>
    <div id="ssLoading" class="ssloading" role="status" hidden>
      <div class="spinner"></div>
      <span id="ssLoadingText">Loading archived capture...</span>
    </div>
    <div id="ssError" class="sserror" hidden role="alert"></div>
    <div id="ssTextPanel" class="sspanel" hidden>
      <button id="ssCopy">Copy text</button>
      <pre id="ssText"></pre>
    </div>
  </div>
  <div class="ssbar">
    <button id="ssPrev">&larr; Prev</button>
    <a id="ssOpen" class="btn" target="_blank" rel="noopener">Open in tab (O)</a>
    <button id="ssTextBtn">Text (T)</button>
    <button id="ssNext">Next &rarr;</button>
  </div>
</div>

<script>
  const cards = [...document.querySelectorAll('.card')];
  const byId = id => document.getElementById(id);
  (function () {
    const list = byId('captureList'), btn = byId('densityBtn'), body = byId('inspBody');
    const setDensity = c => { list.classList.toggle('compact', c); btn.textContent = c ? 'Card view' : 'Compact view'; localStorage.setItem('wb-density', c ? 'c' : 'n'); };
    setDensity(localStorage.getItem('wb-density') === 'c');
    btn.onclick = () => setDensity(!list.classList.contains('compact'));
    const esc = s => String(s).replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
    const fmt = ts => ts.slice(0, 4) + '-' + ts.slice(4, 6) + '-' + ts.slice(6, 8) + ' ' + ts.slice(8, 10) + ':' + ts.slice(10, 12);
    let sel = null;
    list.addEventListener('click', async e => {
      if (e.target.closest('a,button')) return;
      const card = e.target.closest('.card'); if (!card) return;
      if (sel) sel.classList.remove('selected');
      sel = card; card.classList.add('selected');
      const q = new URLSearchParams(location.search);
      body.className = '';
      body.innerHTML = '<dl><dt>URL</dt><dd>' + esc(card.dataset.url) + '</dd><dt>Captured</dt><dd>' + fmt(card.dataset.ts) + '</dd>' +
        '<dt>Saved locally</dt><dd>' + (card.dataset.ready === '1' ? 'Yes' : 'Not yet') + '</dd></dl><div class="panel-title">History</div><div id="inspHist">Loading...</div>';
      try {
        const r = await fetch('/Home/History?url=' + encodeURIComponent(q.get('url') || '') + '&filter=' + encodeURIComponent(q.get('filter') || '') + '&original=' + encodeURIComponent(card.dataset.url));
        const h = await r.json();
        if (sel !== card) return;
        byId('inspHist').innerHTML = h.length ? '<ul class="hist">' + h.map(x => '<li class="' + (x.ts === card.dataset.ts ? 'cur' : '') + '">' + fmt(x.ts) + ' <em>' + esc(x.status) + '</em></li>').join('') + '</ul>' : 'No other captures.';
      } catch { byId('inspHist').textContent = 'History unavailable.'; }
    });
  })();
  const paginationMode = '@Model.PaginationMode';
  const clientPageSize = @Model.PageSize;
  let clientPage = 1;

  function renderClientPage(announce = false) {
    if (paginationMode !== 'client' || !byId('clientPageInfo')) return;
    const totalPages = Math.max(1, Math.ceil(cards.length / clientPageSize));
    clientPage = Math.min(Math.max(1, clientPage), totalPages);
    cards.forEach((card, index) => {
      card.hidden = index < (clientPage - 1) * clientPageSize || index >= clientPage * clientPageSize;
    });
    byId('clientPageInfo').textContent = 'Page ' + clientPage + ' of ' + totalPages + ' (' + cards.length + ' captures loaded)';
    byId('clientPrev').disabled = clientPage === 1;
    byId('clientNext').disabled = clientPage === totalPages;
    byId('clientPrev').setAttribute('aria-disabled', clientPage === 1 ? 'true' : 'false');
    byId('clientNext').setAttribute('aria-disabled', clientPage === totalPages ? 'true' : 'false');
    if (announce) byId('clientPageInfo').focus({ preventScroll: true });
  }
  if (byId('clientPrev')) byId('clientPrev').onclick = () => { clientPage--; renderClientPage(true); };
  if (byId('clientNext')) byId('clientNext').onclick = () => { clientPage++; renderClientPage(true); };
  renderClientPage();

  document.addEventListener('click', e => {
    if (e.target.matches('.view')) startShow(e.target.closest('.card'));
  }, true);

  // ---------------------------------------------------------------- slideshow
  // Two views. "Fast" (default) shows title + extracted text straight from the local database: instant, nothing is
  // loaded from archive.org. "Full" shows the archived page in a frame; that page loads all of its images, styles and
  // scripts live from archive.org, which is slow, so only the current slide and the next one are loaded.
  const ss = byId('ss'), ssMain = byId('ssMain'), ssLoading = byId('ssLoading');
  const ssLoadingText = byId('ssLoadingText'), ssError = byId('ssError'), ssReader = byId('ssReader');
  const ssModeBtn = byId('ssMode');
  const AHEAD = 1, BEHIND = 0, SPINNER_DELAY_MS = 150, TIMEOUT_MS = 20000, TEXT_LOOKAHEAD = 8, TEXT_CACHE_MAX = 80;
  const frames = new Map();                         // full view: slide index -> { el, loaded }
  const seen = new Set();                           // full view: keyOf(card) values that finished loading once
  const textPromises = new Map(), textValues = new Map();   // fast view: text cache
  let mode = localStorage.getItem('wb-mode') === 'fast' ? 'fast' : 'full';
  let list = [], idx = 0, spinnerTimer, loadTimer, boostTimer;
  let lastNavAt = 0;

  function toSlideItem(item) {
    if (item && item.dataset) return item;
    const ts = item?.ts || '';
    const url = item?.url || '';
    const archiveUrl = item?.archiveUrl || ('https://web.archive.org/web/' + ts + '/' + url);
    const frameUrl = item?.frameUrl || ('/Home/Frame?ts=' + ts + '&url=' + encodeURIComponent(url));
    return {
      dataset: {
        ts,
        url,
        key: archiveUrl,
        frame: frameUrl,
        ready: item?.ready ? '1' : '0'
      }
    };
  }

  const keyOf = card => card.dataset.ts + '|' + card.dataset.url;

  function updateModeButton() { ssModeBtn.textContent = mode === 'fast' ? 'IFrame archived page (F)' : 'Fast text view (F)'; }
  function setMode(m) {
    mode = m;
    localStorage.setItem('wb-mode', m);
    updateModeButton();
    if (!ss.hidden) showSlide();
  }
  function dropFrames() { frames.forEach(f => f.el.remove()); frames.clear(); }

  function textFor(card) {
    const key = keyOf(card);
    let p = textPromises.get(key);
    if (!p) {
      p = fetchText(card)
        .catch(e => ({ title: null, description: null, text: '', error: e.message || 'failed' }))
        .then(t => {
          if (t.error) textPromises.delete(key);          // allow a retry later
          else { textValues.set(key, t); card.dataset.ready = '1'; }
          return t;
        });
      textPromises.set(key, p);
      if (textPromises.size > TEXT_CACHE_MAX) {
        const oldest = textPromises.keys().next().value;
        textPromises.delete(oldest); textValues.delete(oldest);
      }
    }
    return p;
  }

  function renderFast(card, t) {
    byId('ssTitle').textContent = t.title || card.dataset.url;
    byId('ssDesc').textContent = t.description || '';
    byId('ssBody').textContent = t.text || t.error || '(no readable text in this capture - press F for the full page)';
    ssReader.scrollTop = 0;
  }

  function showFast(card) {
    dropFrames();
    ssReader.hidden = false;
    byId('ssTextPanel').hidden = true;
    ssLoading.hidden = true;
    const known = textValues.get(keyOf(card));
    if (known) {
      renderFast(card, known);
    } else {
      spinnerTimer = setTimeout(() => {
        if (list[idx] !== card || textValues.has(keyOf(card))) return;
        ssLoadingText.textContent = 'Fetching capture ' + (idx + 1) + ' of ' + list.length + '...';
        ssLoading.hidden = false;
      }, SPINNER_DELAY_MS);
      textFor(card).then(t => {
        if (list[idx] !== card) return;
        clearTimeout(spinnerTimer);
        ssLoading.hidden = true;
        renderFast(card, t);
      });
    }
    for (let d = 1; d <= TEXT_LOOKAHEAD && idx + d < list.length; d++) textFor(list[idx + d]);
  }

  function frameFor(i) {
    let f = frames.get(i);
    if (f) return f;
    const card = list[i];
    const el = document.createElement('iframe');
    el.className = 'ssframe';
    el.setAttribute('sandbox', 'allow-scripts allow-popups');
    el.setAttribute('loading', 'eager');
    el.setAttribute('referrerpolicy', 'no-referrer');
    el.hidden = true;
    f = { el, loaded: false };
    el.addEventListener('load', () => {
      f.loaded = true;
      seen.add(keyOf(card));
      card.dataset.ready = '1';
      if (i === idx && !ss.hidden && mode === 'full') onCurrentLoaded();
    });
    el.src = card.dataset.frame;
    ssMain.insertBefore(el, ssLoading);
    frames.set(i, f);
    return f;
  }

  function onCurrentLoaded() {
    clearTimeout(spinnerTimer);
    clearTimeout(loadTimer);
    ssLoading.hidden = true;
    ssError.hidden = true;
    ss.focus({ preventScroll: true });
  }

  function showFull(card) {
    ssReader.hidden = true;
    for (const [i, f] of [...frames]) {
      if (i < idx - BEHIND || i > idx + AHEAD) { f.el.remove(); frames.delete(i); }
    }
    const current = frameFor(idx);
    frames.forEach((f, i) => { f.el.hidden = i !== idx; });
    for (let d = 1; d <= AHEAD; d++) if (idx + d < list.length) frameFor(idx + d);
    if (idx > 0 && BEHIND > 0) frameFor(idx - 1);

    ssLoading.hidden = true;
    if (!(current.loaded || seen.has(keyOf(card)))) {
      spinnerTimer = setTimeout(() => {
        if (current.loaded) return;
        ssLoadingText.textContent = 'Loading capture ' + (idx + 1) + ' of ' + list.length + '...';
        ssLoading.hidden = false;
      }, SPINNER_DELAY_MS);
      loadTimer = setTimeout(() => {
        if (current.loaded) return;
        // iframe view failed/too slow: automatically fall back to text so the user still sees content immediately.
        mode = 'fast';
        updateModeButton();
        ssLoading.hidden = true;
        ssError.textContent = 'IFrame view is slow or blocked for this capture. Switched to fast text view automatically.';
        ssError.hidden = false;
        showFast(card);
      }, TIMEOUT_MS);
    }
    if (!byId('ssTextPanel').hidden) loadSlideText();
  }

  function showSlide() {
    const card = list[idx];
    byId('ssInfo').textContent = (idx + 1) + ' / ' + list.length + '  |  ' + card.dataset.url;
    byId('ssOpen').href = card.dataset.key;
    history.replaceState(null, '', location.pathname + location.search + '#capture=' + encodeURIComponent(card.dataset.ts));
    clearTimeout(spinnerTimer);
    clearTimeout(loadTimer);
    ssError.hidden = true;
    if (mode === 'fast') showFast(card); else showFull(card);
    boost();
  }

  // Ask the server to download the next captures first (only matters while the background download is running).
  function boost() {
    clearTimeout(boostTimer);
    boostTimer = setTimeout(() => {
      const keys = [];
      for (let i = idx; i < Math.min(list.length, idx + 12); i++) {
        const c = list[i];
        if (c.dataset.ready !== '1') keys.push(keyOf(c));
      }
      if (keys.length)
        fetch('/Home/Prioritize', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(keys) })
          .catch(() => {});
    }, 150);
  }

  function startShow(startCard = null, source = null) {
    const base = source ? source.map(toSlideItem) : [...cards].map(toSlideItem);
    list = base.sort((a, b) => a.dataset.ts.localeCompare(b.dataset.ts));
    if (!list.length) { alert('No captures available.'); return; }
    idx = startCard ? Math.max(0, list.indexOf(startCard)) : 0;
    updateModeButton();
    ss.hidden = false;
    document.body.style.overflow = 'hidden';
    showSlide();
    ss.focus({ preventScroll: true });
  }
  function findCapture(value) {
    const target = String(value || '').trim();
    if (!target) return null;
    if (/^\d+$/.test(target) && target.length < 14) {
      const number = Number(target);
      return number >= 1 && number <= list.length ? list[number - 1] : null;
    }
    return list.find(card => card.dataset.ts === target) || null;
  }
  function jumpTo(value) {
    const card = findCapture(value);
    if (!card) { alert('Capture not found. Enter a number from 1 to ' + list.length + ' or a full timestamp.'); return; }
    idx = list.indexOf(card);
    showSlide();
    ss.focus({ preventScroll: true });
  }
  function closeShow() {
    clearTimeout(spinnerTimer); clearTimeout(loadTimer);
    dropFrames();
    ss.hidden = true;
    document.body.style.overflow = '';
  }
  function showEdgeHint(text) {
    ssError.textContent = text;
    ssError.hidden = false;
    setTimeout(() => {
      if (!ss.hidden) ssError.hidden = true;
    }, 900);
  }
  function nextSlide() {
    if (idx < list.length - 1) { idx++; showSlide(); return; }
    showEdgeHint('End of slideshow.');
  }
  function prevSlide() {
    if (idx > 0) { idx--; showSlide(); return; }
    showEdgeHint('Start of slideshow.');
  }

  const playAll = byId('playAll');
  if (playAll) playAll.onclick = () => startShow();
  const playAllAll = byId('playAllAll');
  if (playAllAll) playAllAll.onclick = async () => {
    try {
      playAllAll.disabled = true;
      playAllAll.textContent = 'Loading full set...';
      const all = await fetchCaptureSet();
      if (!all || !all.length) { alert('No captures available for current filters.'); return; }
      startShow(null, all);
    } catch {
      alert('Could not open slideshow for full filtered set.');
    } finally {
      playAllAll.disabled = false;
      playAllAll.textContent = 'Slideshow all (filtered)';
    }
  };
  byId('ssJumpBtn').onclick = () => jumpTo(byId('ssJump').value);
  byId('ssJump').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); jumpTo(e.target.value); } });
  byId('ssClose').onclick = closeShow;
  byId('ssNext').onclick = nextSlide;
  byId('ssPrev').onclick = prevSlide;
  ssModeBtn.onclick = () => setMode(mode === 'fast' ? 'full' : 'fast');
  updateModeButton();

  const initialCapture = new URLSearchParams(location.hash.substring(1)).get('capture');
  if (initialCapture && cards.length) { startShow(); jumpTo(initialCapture); }

  document.addEventListener('keydown', e => {
    if (ss.hidden) return;
    if (e.target && e.target.id === 'ssJump') return;
    if (e.altKey || e.ctrlKey || e.metaKey) return;
    if (e.repeat && (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === 'ArrowLeft' || e.key === 'PageUp')) {
      const now = Date.now();
      if (now - lastNavAt < 70) { e.preventDefault(); return; }
      lastNavAt = now;
    }
    if (e.key === 'ArrowRight' || e.key === 'PageDown') { e.preventDefault(); nextSlide(); }
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); prevSlide(); }
    else if (e.key === 'Home') { e.preventDefault(); idx = 0; showSlide(); }
    else if (e.key === 'End') { e.preventDefault(); idx = list.length - 1; showSlide(); }
    else if (e.key === 'f' || e.key === 'F') setMode(mode === 'fast' ? 'full' : 'fast');
    else if (e.key === 'o' || e.key === 'O') window.open(list[idx].dataset.key, '_blank', 'noopener');
    else if ((e.key === 't' || e.key === 'T') && mode === 'full') toggleText();
    else if (e.key === 'Escape') closeShow();
  });

  // ---------------------------------------------------------------- text panel + export
  async function fetchText(card) {
    const r = await fetch('/Home/Text?ts=' + card.dataset.ts + '&url=' + encodeURIComponent(card.dataset.url));
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json();
  }
  async function loadSlideText() {
    const c = list[idx];
    const box = byId('ssText');
    box.textContent = 'Loading text...';
    try {
      const t = await fetchText(c);
      if (list[idx] !== c) return; // the user already moved on
      const txt = [t.title, t.description, '', t.text].filter(x => x !== null && x !== undefined).join('\n').trim();
      box.textContent = txt || t.error || '(no readable text in this capture - probably a JavaScript-only page)';
    } catch { box.textContent = '(failed to load text)'; }
  }
  function toggleText() {
    const panel = byId('ssTextPanel');
    panel.hidden = !panel.hidden;
    if (!panel.hidden) loadSlideText();
  }
  byId('ssTextBtn').onclick = toggleText;
  byId('ssCopy').onclick = () => navigator.clipboard.writeText(byId('ssText').textContent);

  // ---------------------------------------------------------------- background preload progress
  const preloadStatus = byId('preloadStatus');
  const eta = sec => sec < 90 ? Math.round(sec) + ' s' : sec < 5400 ? Math.round(sec / 60) + ' min' : (sec / 3600).toFixed(1) + ' h';
  async function pollPreloadStatus() {
    if (!preloadStatus) return;
    try {
      const r = await fetch('/Home/PreloadStatus');
      if (!r.ok) return;
      const p = await r.json();
      if (p.total) {
        const speed = p.perSecond ? ' - ' + p.perSecond.toFixed(1) + ' pages/s' : '';
        const left = p.running && p.etaSeconds ? ', about ' + eta(p.etaSeconds) + ' left' : '';
        const detail = p.running ? ` [${p.inFlight} downloading, ${p.queued} queued, ${p.activeWorkers} workers, ${(p.jobs || []).filter(j => j.state === 1).length} active jobs]` : '';
        preloadStatus.textContent = (p.running ? 'Downloading and saving: ' : 'Saved: ') +
          p.completed + ' / ' + p.total + (p.failed ? ' (' + p.failed + ' failed)' : '') + speed + left + detail;
      }
      if (p.running) setTimeout(pollPreloadStatus, 1000);
    } catch { setTimeout(pollPreloadStatus, 2000); }
  }
  pollPreloadStatus();

  let exporting = false, cancelExport = false;
  let lastExportLaunchAt = 0;
  const busyButtonText = new WeakMap();
  function setButtonBusy(button, busy, busyText = null) {
    if (!button) return;
    if (busy) {
      if (!busyButtonText.has(button)) busyButtonText.set(button, button.textContent);
      button.disabled = true;
      button.classList.add('btn-busy');
      if (busyText) button.textContent = busyText;
      return;
    }
    button.disabled = false;
    button.classList.remove('btn-busy');
    if (busyButtonText.has(button)) {
      button.textContent = busyButtonText.get(button);
      busyButtonText.delete(button);
    }
  }
  const csvCell = v => '"' + String(v ?? '').replace(/"/g, '""') + '"';
  const htmlCell = v => String(v ?? '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');

  function buildFile(out, fmt) {
    if (fmt === 'xls') {
      const head = ['URL', 'Archive URL', 'Timestamp', 'Title', 'Description', 'Text', 'Error'];
      const rows = out.map(o => [o.url, o.archive, o.ts, o.title, o.description, o.text, o.error]);
      const table = [head, ...rows].map((row, i) =>
        '<tr>' + row.map(value => '<' + (i === 0 ? 'th' : 'td') + '>' + htmlCell(value) + '</' + (i === 0 ? 'th' : 'td') + '>').join('') + '</tr>'
      ).join('');
      return '<!DOCTYPE html><html><head><meta charset="utf-8"><style>' +
        'th{background:#d9eaf7;font-weight:bold}td,th{border:1px solid #999;padding:4px;vertical-align:top;white-space:pre-wrap}' +
        '</style></head><body><table>' + table + '</table></body></html>';
    }
    if (fmt === 'json') return JSON.stringify(out, null, 2);
    if (fmt === 'csv') {
      const head = ['url', 'archive_url', 'timestamp', 'title', 'description', 'text', 'error'];
      const rows = out.map(o => [o.url, o.archive, o.ts, o.title, o.description, o.text, o.error].map(csvCell).join(','));
      return [head.join(',')].concat(rows).join('\r\n');
    }
    return out.map(o =>
      '==== ' + o.url + '\nArchive: ' + o.archive + '\nCaptured: ' + o.ts +
      '\nTitle: ' + (o.title || '') + '\nDescription: ' + (o.description || '') + '\nError: ' + (o.error || '') + '\n\n' + (o.text || '') + '\n\n'
    ).join('');
  }

  async function fetchCaptureSet() {
    const q = new URLSearchParams(location.search);
    const url = q.get('url') || searchBar?.querySelector('[name=url]')?.value || '';
    if (!url) return [];
    const params = new URLSearchParams();
    params.set('url', url);
    params.set('filter', q.get('filter') || searchBar?.querySelector('[name=filter]')?.value || 'html200');
    params.set('searchMode', q.get('searchMode') || searchBar?.querySelector('[name=searchMode]')?.value || 'url');
    ['year','category','status','section','q'].forEach(k => { const v = q.get(k); if (v) params.set(k, v); });
    const r = await fetch('/Home/CaptureSet?' + params.toString());
    if (!r.ok) throw new Error('Could not load full filtered capture set');
    return await r.json();
  }

  function setExportButtonsBusy(busy) {
    setButtonBusy(expAll, busy, 'Exporting...');
    setButtonBusy(expAllFiltered, busy, 'Exporting...');
  }

  async function exportText(items = cards) {
    const st = byId('expStatus');
    if (exporting) { cancelExport = true; return; }
    if (!items.length) { alert('No captures available.'); return; }
    const fmt = byId('expFmt').value;
    exporting = true; cancelExport = false;
    setExportButtonsBusy(true);
    const out = [];
    let nextItem = 0;
    async function worker() {
      while (!cancelExport && nextItem < items.length) {
        const i = nextItem++;
        const c = items[i];
        const ts = c.dataset?.ts || c.ts;
        const url = c.dataset?.url || c.url;
        const archive = c.dataset?.key || c.archiveUrl || ('https://web.archive.org/web/' + ts + '/' + url);
        let t, error = '';
        try {
          const r = await fetch('/Home/Text?ts=' + ts + '&url=' + encodeURIComponent(url));
          if (!r.ok) throw new Error('HTTP ' + r.status);
          t = await r.json();
          error = t.error || '';
        }
        catch (e) { t = { title: null, description: null, text: '' }; error = e.message || 'Text extraction failed'; }
        out.push({ i, url, archive, ts,
                   title: t.title, description: t.description, text: t.text, error });
        const failed = out.filter(o => o.error).length;
        st.textContent = 'Exporting ' + out.length + ' / ' + items.length + (failed ? ' (' + failed + ' failed)' : '') + ' - click again to stop';
      }
    }
    try {
      await Promise.all([worker(), worker(), worker(), worker(), worker(), worker()]);
      out.sort((a, b) => a.i - b.i);
      const isExcel = fmt === 'xls';
      const blob = new Blob([buildFile(out, fmt)], { type: isExcel ? 'application/vnd.ms-excel' : 'text/plain;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'wayback-export-all.' + (isExcel ? 'xls' : fmt);
      a.click();
      const failedCount = out.filter(o => o.error).length;
      st.textContent = 'Saved ' + out.length + ' pages' + (cancelExport ? ' (stopped early)' : '') +
        (failedCount ? ' with ' + failedCount + ' errors' : '');
    } finally {
      exporting = false;
      setExportButtonsBusy(false);
    }
  }
  const expAll = byId('expAll');
  function openExportWindow(mode) {
    const now = Date.now();
    if (now - lastExportLaunchAt < 600) return true;
    lastExportLaunchAt = now;
    const current = new URL(location.href);
    current.searchParams.set('exportMode', mode);
    current.searchParams.set('exportFmt', byId('expFmt')?.value || 'xls');
    const opened = window.open(current.toString(), '_blank', 'noopener');
    return !!opened;
  }

  if (expAll) expAll.onclick = () => {
    if (exporting) return;
    if (openExportWindow('page')) return;
    exportText(cards);
  };
  const expAllFiltered = byId('expAllFiltered');
  if (expAllFiltered) expAllFiltered.onclick = async () => {
    if (exporting) return;
    if (openExportWindow('filtered')) return;
    try {
      const all = await fetchCaptureSet();
      await exportText(all);
    } catch (e) {
      byId('expStatus').textContent = (e && e.message) ? e.message : 'Could not export full filtered set.';
    }
  };

  async function maybeAutoStartExportFromQuery() {
    const q = new URLSearchParams(location.search);
    const mode = (q.get('exportMode') || '').toLowerCase();
    if (mode !== 'page' && mode !== 'filtered') return;

    const fmt = (q.get('exportFmt') || '').toLowerCase();
    const fmtSelect = byId('expFmt');
    if (fmtSelect && ['xls', 'txt', 'json', 'csv'].includes(fmt)) fmtSelect.value = fmt;

    const clean = new URL(location.href);
    clean.searchParams.delete('exportMode');
    clean.searchParams.delete('exportFmt');
    history.replaceState(null, '', clean.pathname + clean.search + clean.hash);

    byId('expStatus').textContent = mode === 'filtered'
      ? 'Export started in this tab (full filtered set)...'
      : 'Export started in this tab (current page)...';

    try {
      if (mode === 'filtered') {
        const all = await fetchCaptureSet();
        await exportText(all);
      } else {
        await exportText(cards);
      }
    } catch (e) {
      byId('expStatus').textContent = (e && e.message) ? e.message : 'Could not start export.';
    }
  }
  maybeAutoStartExportFromQuery();

  // ---------------------------------------------------------------- durable background activity
  const operationStates = ['Queued', 'Running', 'Paused', 'Stopping', 'Stopped', 'Interrupted', 'Completed', 'Failed'];
  const operationKinds = ['CaptureLoad', 'WaybackRefresh', 'PagePreload'];
  const activityImmediate = byId('activityImmediate');
  const workflowTimeline = byId('workflowTimeline');
  const captureBar = byId('captureBar');
  const preloadBar = byId('preloadBar');
  const captureText = byId('captureText');
  const preloadText = byId('preloadText');
  const searchBar = byId('searchBar');
  const searchModeSelect = byId('searchModeSelect');
  const queryInput = byId('queryInput');
  const applyTextFilterBtn = byId('applyTextFilter');
  const filterDirtyBadge = byId('filterDirtyBadge');
  const searchModeHelp = byId('searchModeHelp');
  let pendingSearch = null;
  let lastAppliedFilterState = null;
  const stateText = state => operationStates[state] || 'Unknown';
  const kindText = kind => operationKinds[kind] || 'Unknown';
  const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function currentQuery() {
    if (pendingSearch && pendingSearch.prefix) return { url: pendingSearch.prefix, filter: pendingSearch.filter, active: true };
    return {
      url: searchBar?.querySelector('[name=url]')?.value || '',
      filter: searchBar?.querySelector('[name=filter]')?.value || 'html200',
      active: false
    };
  }

  function renderBar(bar, text, wf) {
    if (!bar || !text || !wf) return;
    bar.style.width = Math.max(0, Math.min(100, wf.percent || 0)) + '%';
    text.textContent = `${wf.state}${wf.total ? ` (${wf.completed}/${wf.total})` : ''}${wf.error ? ` - ${wf.error}` : ''}`;
    bar.className = wf.error ? 'wf-err' : (wf.active ? 'wf-on' : 'wf-done');
  }

  function searchContextFromForm() {
    return {
      url: searchBar?.querySelector('[name=url]')?.value || '',
      filter: searchBar?.querySelector('[name=filter]')?.value || 'html200',
      pagination: searchBar?.querySelector('[name=pagination]')?.value || 'server',
      pageSize: searchBar?.querySelector('[name=pageSize]')?.value || '50',
      searchMode: searchModeSelect?.value || 'url',
      q: queryInput?.value || ''
    };
  }

  function buildTargetUrl(payload) {
    const params = new URLSearchParams();
    params.set('url', payload.url || '');
    params.set('filter', payload.filter || 'html200');
    params.set('pagination', payload.pagination || 'server');
    params.set('pageSize', String(payload.pageSize || 50));
    params.set('searchMode', payload.searchMode || 'url');
    if ((payload.q || '').trim()) params.set('q', payload.q.trim());
    return '/?' + params.toString();
  }

  function currentFilterState() {
    const s = searchContextFromForm();
    return JSON.stringify({
      url: (s.url || '').trim(),
      filter: s.filter || 'html200',
      searchMode: s.searchMode || 'url',
      q: (s.q || '').trim()
    });
  }

  function updateFilterDirtyBadge() {
    if (!filterDirtyBadge) return;
    const current = currentFilterState();
    const dirty = lastAppliedFilterState !== null && current !== lastAppliedFilterState;
    filterDirtyBadge.hidden = !dirty;
    if (applyTextFilterBtn) {
      applyTextFilterBtn.classList.toggle('btn-dirty', dirty);
      applyTextFilterBtn.setAttribute('aria-label', dirty ? 'Apply filter changes (pending)' : 'Apply filter');
    }
  }

  function updateSearchHelp() {
    if (!searchModeHelp) return;
    const mode = searchModeSelect?.value || 'url';
    if (mode === 'content') {
      searchModeHelp.textContent = 'Content mode: type text in "Search captures" and click "Apply filter" (or Load captures/Refresh) to run content filtering.';
      if (queryInput) queryInput.placeholder = 'Type text to find inside archived page content';
      return;
    }
    searchModeHelp.textContent = 'URL mode: URL box controls capture loading. "Search captures" is an optional extra filter applied when you click "Apply filter".';
    if (queryInput) queryInput.placeholder = 'Optional filter keywords';
  }

  updateSearchHelp();
  lastAppliedFilterState = currentFilterState();
  updateFilterDirtyBadge();
  if (searchModeSelect) searchModeSelect.addEventListener('change', updateSearchHelp);
  if (searchBar) {
    searchBar.addEventListener('input', updateFilterDirtyBadge);
    searchBar.addEventListener('change', updateFilterDirtyBadge);
  }

  if (applyTextFilterBtn) applyTextFilterBtn.onclick = () => {
    const payload = searchContextFromForm();
    if (!payload.url.trim()) {
      activityImmediate.textContent = 'Enter a URL/prefix first, then apply a filter.';
      return;
    }
    activityImmediate.textContent = payload.searchMode === 'content'
      ? 'Applying content filter...'
      : 'Applying URL filter...';
    lastAppliedFilterState = currentFilterState();
    updateFilterDirtyBadge();
    location.href = buildTargetUrl(payload);
  };

  if (searchBar) searchBar.addEventListener('submit', async e => {
    e.preventDefault();
    const refresh = e.submitter && e.submitter.name === 'refresh';
    activityImmediate.textContent = refresh ? 'Refreshing from Wayback...' : 'Loading capture list...';
    const buttons = [...searchBar.querySelectorAll('button')];
    buttons.forEach(button => button.disabled = true);
    try {
      const data = new FormData(searchBar);
      if (refresh) data.set('refresh', 'true');
      const response = await fetch('/Home/StartSearch', { method: 'POST', body: data });
      if (!response.ok) throw new Error(await response.text());
       pendingSearch = await response.json();
       const current = searchContextFromForm();
       lastAppliedFilterState = currentFilterState();
       updateFilterDirtyBadge();
       const target = buildTargetUrl({
         url: pendingSearch.prefix,
         filter: pendingSearch.filter,
         pagination: pendingSearch.pagination || current.pagination,
         pageSize: pendingSearch.pageSize || current.pageSize,
         searchMode: pendingSearch.searchMode || current.searchMode,
         q: current.q
       });
       if (pendingSearch.cached) {
         activityImmediate.textContent = 'Capture list already loaded; opening saved results...';
         location.href = target;
         return;
       }

       pendingSearch.requestedAt = Date.now();
       activityImmediate.textContent = 'Capture load started in background...';
       buttons.forEach(button => button.disabled = false);
       pollWorkflow();
    } catch (error) {
      activityImmediate.textContent = 'Search could not be started: ' + (error.message || 'unknown error');
      buttons.forEach(button => button.disabled = false);
    }
  });

  async function sendOperationCommand(name, operationId = null) {
    const query = operationId
      ? '?operationId=' + encodeURIComponent(operationId)
      : '?url=' + encodeURIComponent(searchBar.querySelector('[name=url]').value) +
        '&filter=' + encodeURIComponent(searchBar.querySelector('[name=filter]').value);
    const response = await fetch('/Home/' + name + query, { method: 'POST' });
    if (!response.ok) throw new Error('HTTP ' + response.status);
  }

  function selectedOperationIds() {
    return [...selectedOperationIdsState];
  }

  function isActiveState(state) {
    return [0, 1, 2, 3, 5].includes(state);
  }

  function updateActivityControls(operations) {
    const activeCount = (operations || []).filter(o => isActiveState(o.state)).length;
    const selected = selectedOperationIds().length;
    if (activitySelectionInfo) activitySelectionInfo.textContent = `${selected} selected · ${activeCount} active`;

    const busy = commandInFlight;
    if (selectActiveOpsBtn) selectActiveOpsBtn.disabled = busy || activeCount === 0;
    if (clearSelectedOpsBtn) clearSelectedOpsBtn.disabled = busy || selected === 0;

    const canBulk = !busy && (selected > 0 || activeCount > 0);
    if (pauseWorkBtn) pauseWorkBtn.disabled = !canBulk;
    if (resumeWorkBtn) resumeWorkBtn.disabled = !canBulk;
    if (stopWorkBtn) stopWorkBtn.disabled = !canBulk;
  }

  async function commandSelected(name, explicitIds = null) {
    if (commandInFlight) return;
    const ids = selectedOperationIds();
    const targetIds = explicitIds ?? ids;
    activityImmediate.textContent = name === 'Pause' ? 'Pausing downloads...' :
      name === 'Resume' ? 'Resuming downloads...' : 'Stopping downloads...';
    commandInFlight = true;
    updateActivityControls(lastOperations);
    const actionButton = name === 'Pause' ? pauseWorkBtn : name === 'Resume' ? resumeWorkBtn : stopWorkBtn;
    setButtonBusy(actionButton, true, name + '...');
    if (!targetIds.length) {
      try {
        await sendOperationCommand(name);
        await pollWorkflow();
      } catch {
        activityImmediate.textContent = 'Could not change background activity.';
      } finally {
        commandInFlight = false;
        setButtonBusy(actionButton, false);
        updateActivityControls(lastOperations);
      }
      return;
    }
    try {
      await Promise.all(targetIds.map(id => sendOperationCommand(name, id)));
      await pollWorkflow();
    } catch {
      activityImmediate.textContent = 'Could not change background activity.';
    } finally {
      commandInFlight = false;
      setButtonBusy(actionButton, false);
      updateActivityControls(lastOperations);
    }
  }

  if (selectActiveOpsBtn) selectActiveOpsBtn.onclick = () => {
    selectedOperationIdsState.clear();
    for (const op of (lastOperations || [])) {
      if (isActiveState(op.state)) selectedOperationIdsState.add(String(op.id));
    }
    renderOperationTimeline(lastOperations);
    updateActivityControls(lastOperations);
  };

  if (clearSelectedOpsBtn) clearSelectedOpsBtn.onclick = () => {
    selectedOperationIdsState.clear();
    renderOperationTimeline(lastOperations);
    updateActivityControls(lastOperations);
  };

  if (pauseWorkBtn) pauseWorkBtn.onclick = () => commandSelected('Pause');
  if (resumeWorkBtn) resumeWorkBtn.onclick = () => commandSelected('Resume');
  if (stopWorkBtn) stopWorkBtn.onclick = () => commandSelected('Stop');

  workflowTimeline.addEventListener('change', e => {
    const cb = e.target.closest('.operation-select');
    if (!cb) return;
    if (cb.checked) selectedOperationIdsState.add(cb.value);
    else selectedOperationIdsState.delete(cb.value);
    updateActivityControls(lastOperations);
  });

  workflowTimeline.addEventListener('click', e => {
    const button = e.target.closest('[data-operation-command]');
    if (!button) return;
    setButtonBusy(button, true, button.dataset.operationCommand + '...');
    commandSelected(button.dataset.operationCommand, [button.dataset.operationId])
      .finally(() => setButtonBusy(button, false));
  });

  function renderOperationTimeline(operations) {
    if (!workflowTimeline) return;
    lastOperations = operations || [];
    const knownIds = new Set(lastOperations.map(o => String(o.id)));
    for (const id of [...selectedOperationIdsState]) {
      if (!knownIds.has(id)) selectedOperationIdsState.delete(id);
    }
    const visible = (operations || []).slice(0, 24);
    workflowTimeline.innerHTML = visible.length
      ? visible.map(o => {
          const progress = o.total ? ` (${o.completed}/${o.total})` : '';
          const error = o.error ? ` <span class="operation-error">${esc(o.error)}</span>` : '';
          const active = [0, 1, 2, 3, 5].includes(o.state);
          const checked = selectedOperationIdsState.has(String(o.id)) ? ' checked' : '';
          const controls = active
            ? `<label><input type="checkbox" class="operation-select" value="${o.id}"${checked} aria-label="Select ${esc(kindText(o.kind))} for ${esc(o.prefix)}"></label>
               <button type="button" data-operation-command="Pause" data-operation-id="${o.id}">Pause</button>
               <button type="button" data-operation-command="Resume" data-operation-id="${o.id}">Resume</button>
               <button type="button" data-operation-command="Stop" data-operation-id="${o.id}">Stop</button>`
            : '';
          return `<div class="operation"><span>${controls}</span><strong>${esc(kindText(o.kind))}: ${esc(o.prefix)}</strong><span>${esc(stateText(o.state))}${progress}</span>${error}</div>`;
        }).join('')
      : 'No workflow events yet.';
    updateActivityControls(lastOperations);
  }

  async function pollWorkflow() {
    try {
      const q = currentQuery();
      if (!q.url) return;
      const [wfResponse, opResponse] = await Promise.all([
        fetch('/Home/WorkflowStatus?url=' + encodeURIComponent(q.url) + '&filter=' + encodeURIComponent(q.filter)),
        fetch('/Home/OperationStatus')
      ]);
      if (!wfResponse.ok) return;
      const wf = await wfResponse.json();
      const operations = opResponse.ok ? await opResponse.json() : [];

      renderBar(captureBar, captureText, wf.captureLoad);
      renderBar(preloadBar, preloadText, wf.preload);
      renderOperationTimeline(operations);

      if (pendingSearch) {
        const captureState = String(wf.captureLoad?.state || '');
        if (captureState === 'Completed' || captureState === 'Failed') {
          const target = '/?url=' + encodeURIComponent(pendingSearch.prefix) + '&filter=' + encodeURIComponent(pendingSearch.filter) + '&pagination=' + encodeURIComponent(pendingSearch.pagination || 'server') + '&pageSize=' + encodeURIComponent(pendingSearch.pageSize || 50);
          pendingSearch = null;
          location.href = target;
          return;
        }
      }

      if (pendingSearch && Date.now() - (pendingSearch.requestedAt || 0) < 8000 && wf.message === 'No workflow yet') {
        activityImmediate.textContent = 'Starting capture load...';
      } else {
        activityImmediate.textContent = wf.message || 'Background work is idle';
      }

      const active = wf.captureLoad?.active || wf.preload?.active || (operations || []).some(o => [0,1,2,3,5].includes(o.state)) || (pendingSearch && Date.now() - (pendingSearch.requestedAt || 0) < 8000) || q.active;
      if (active) setTimeout(pollWorkflow, 1000);
    } catch { setTimeout(pollWorkflow, 2000); }
  }
  pollWorkflow();
</script>
