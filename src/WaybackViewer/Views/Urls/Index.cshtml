@model WaybackViewer.Models.UrlListViewModel
@{
	ViewData["Title"] = "Searched URLs";
	string Link(string? sort, string? after, long afterId) =>
		"/urls?sort=" + Uri.EscapeDataString(sort ?? Model.Sort) +
		(string.IsNullOrEmpty(Model.Search) ? "" : "&q=" + Uri.EscapeDataString(Model.Search)) +
		(after is null ? "" : "&after=" + Uri.EscapeDataString(after) + "&afterId=" + afterId);
}
<section class="ops-page">
<h1>Searched URLs</h1>
<form method="get" action="/urls" class="ops-filters">
<input type="search" name="q" value="@Model.Search" placeholder="Filter URLs" aria-label="Filter searched URLs" maxlength="200" />
<select name="sort" aria-label="Sort">
<option value="captures" selected="@(Model.Sort == "captures")">Most captures</option>
<option value="recent" selected="@(Model.Sort == "recent")">Recently searched</option>
<option value="az" selected="@(Model.Sort == "az")">A–Z</option>
</select>
<button type="submit">Apply</button>
</form>
<div class="table-scroll"><table class="ops-table" id="urlsTable">
<thead><tr><th>URL</th><th>Captures</th><th class="hide-sm">First</th><th class="hide-sm">Last</th><th class="hide-xs">Preloaded</th><th class="hide-md">Last refresh</th><th></th></tr></thead>
<tbody>
@foreach (var u in Model.Items)
{
<tr data-url-id="@u.Id">
<td class="cell-fill" title="@u.Prefix"><a href="/urls/@u.Id">@u.Prefix</a> <small>(@u.Filter)</small></td>
<td>@WaybackViewer.Models.DisplayFormat.Number(u.CaptureCount)</td>
<td class="hide-sm">@WaybackViewer.Models.DisplayFormat.Timestamp(u.FirstTimestamp)</td>
<td class="hide-sm">@WaybackViewer.Models.DisplayFormat.Timestamp(u.LastTimestamp)</td>
<td class="hide-xs"><progress max="100" value="@u.PreloadPercent" aria-label="Preloaded"></progress> @u.PreloadPercent%</td>
<td class="hide-md">@u.LastRefresh.ToString("yyyy-MM-dd")</td>
<td><a href="/?url=@Uri.EscapeDataString(u.Prefix)&amp;filter=@Uri.EscapeDataString(u.Filter)">Open</a></td>
</tr>
}
@if (Model.Items.Count == 0)
{
<tr><td colspan="7">No searched URLs found.</td></tr>
}
</tbody>
</table></div>
<nav class="pager" aria-label="Pages">
@if (!Model.IsFirstPage) { <a href="@Link(Model.Sort, null, 0)">First page</a> }
@if (Model.HasMore) { <a href="@Link(Model.Sort, Model.NextKey, Model.NextId)" rel="next">Next</a> }
</nav>
</section>
